{
  "name": "pro-schulraum-wangen-ch",
  "compatibility_date": "2026-09-09",
  // Small worker for the story form (/api/*); everything else is the static site.
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wangen-stories",
      // Replace with the id printed by `npx wrangler d1 create wangen-stories`
      // before the first deploy. Local testing works with the placeholder.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ]
}
