{
	"name": "pro-schulraum-wangen-ch",
	"compatibility_date": "2026-09-09",
	// Small worker for the story form and flyer sign-ups (/api/*); everything else is the static site.
	"main": "./worker/index.js",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// serve dist/404.html (with status 404) for unknown paths
		"not_found_handling": "404-page",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "wangen-stories",
			"database_id": "d363ba0d-4635-4f18-905e-3843c7f8bfe5",
      "migrations_dir": "./migrations"
		}
	]
}