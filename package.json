{
  "name": "pro-schulraum-wangen",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "astro build && wrangler deploy",
    "preview:cf": "astro build && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply wangen-stories --local",
    "db:migrate:remote": "wrangler d1 migrations apply wangen-stories --remote"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/inter": "^5.3.0",
    "astro": "^7.3.2",
    "sharp": "^0.35.4"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3",
    "wrangler": "^4.130.0"
  }
}
