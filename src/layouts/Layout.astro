---
import { getImage } from 'astro:assets';
import '../styles/global.css';
import {
	SITE_TITLE,
	SITE_DESCRIPTION,
	NAV_LINKS,
	OFFICIAL_SITE_URL,
	OFFICIAL_SITE_LABEL,
	VOTE_DATE_LABEL,
	DOCUMENTS,
} from '../consts';
import ogSourceImg from '../assets/visualizations/dorfplatz-primarschule_02.jpg';

interface Props {
	title?: string;
	description?: string;
}

const { title, description = SITE_DESCRIPTION } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : `${SITE_TITLE} – Ja zur neuen Schulanlage «Am Buechberg»`;
const currentPath = new URL(Astro.request.url).pathname;
const canonicalURL = new URL(currentPath, Astro.site);

// Shared social-share image (Open Graph / Twitter Card), cropped to the
// 1200×630 size those platforms expect. Sized and compressed separately
// from the on-page hero background, which needs a much larger source.
const ogImage = await getImage({
	src: ogSourceImg,
	width: 1200,
	height: 630,
	position: 'attention',
	format: 'jpg',
	quality: 75,
});
const ogImageURL = new URL(ogImage.src, Astro.site);
---

<!doctype html>
<html lang="de-CH">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_TITLE} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:locale" content="de_CH" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<meta name="generator" content={Astro.generator} />

		<slot name="head" />
	</head>
	<body>
		<div class="vote-banner">
			{VOTE_DATE_LABEL} — <a href="/argumente/">Weshalb Ja?</a>
		</div>
		<header class="site-header">
			<div class="wrap">
				<a class="brand" href="/">
					<span class="dot" aria-hidden="true"></span>
					{SITE_TITLE}
				</a>
				<button
					type="button"
					class="nav-toggle"
					aria-expanded="false"
					aria-controls="main-nav"
					aria-label="Menü"
				>
					<span class="nav-toggle-bar" aria-hidden="true"></span>
				</button>
				<nav class="main-nav" id="main-nav" aria-label="Hauptnavigation">
					{
						NAV_LINKS.map((link) => (
							<a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
								{link.label}
							</a>
						))
					}
				</nav>
			</div>
		</header>
		<script is:inline>
			(function () {
				var btn = document.querySelector('.nav-toggle');
				var nav = document.getElementById('main-nav');
				if (!btn || !nav) return;
				document.documentElement.classList.add('has-js-nav');
				var setOpen = function (open) {
					nav.classList.toggle('is-open', open);
					btn.setAttribute('aria-expanded', String(open));
				};
				btn.addEventListener('click', function () {
					setOpen(btn.getAttribute('aria-expanded') !== 'true');
				});
				nav.addEventListener('click', function (e) {
					if (e.target.closest('a')) setOpen(false);
				});
				document.addEventListener('keydown', function (e) {
					if (e.key === 'Escape') setOpen(false);
				});
			})();
		</script>
		<script is:inline>
			(function () {
				if (!('IntersectionObserver' in window)) return;
				if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

				function init() {
					document.documentElement.classList.add('js-reveal');
					var targets = document.querySelectorAll(
						'.card, .mission-card, .supporter-card, .gallery-grid figure, .gallery-full, .cost-summary, .cost-calc-explainer',
					);
					var observer = new IntersectionObserver(
						function (entries) {
							entries.forEach(function (entry) {
								if (entry.isIntersecting) {
									entry.target.classList.add('is-visible');
									observer.unobserve(entry.target);
								}
							});
						},
						{ threshold: 0.15, rootMargin: '0px 0px -40px 0px' },
					);
					targets.forEach(function (el) {
						observer.observe(el);
					});
				}

				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', init);
				} else {
					init();
				}
			})();
		</script>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="wrap">
				<p>
					<strong>{SITE_TITLE}</strong> ist eine unabhängige Gruppe von Einwohnerinnen und
					Einwohnern von Wangen SZ. Wir sind nicht Teil der Gemeindeverwaltung.
				</p>
				<p>
					Offizielle Informationen der Gemeinde zum Projekt finden Sie auf der{' '}
					<a href={OFFICIAL_SITE_URL} target="_blank" rel="noopener">{OFFICIAL_SITE_LABEL}</a>.
				</p>
				<p>
					<a href="/datenschutz/">Datenschutz</a> ·{' '}
					<a href="https://github.com/Pro-Schulraum-Wangen/Website" target="_blank" rel="noopener">
						Quellcode auf GitHub
					</a>
				</p>
				<p class="disclaimer">
					Alle Angaben zum Projekt basieren auf der öffentlichen{' '}
					<a href={DOCUMENTS.botschaft} target="_blank" rel="noopener">
						Botschaft des Gemeinderates Wangen
					</a>{' '}
					vom 11. Juni 2026 sowie der{' '}
					<a href={DOCUMENTS.infoanlass} target="_blank" rel="noopener">
						Präsentation der Informationsveranstaltung
					</a>{' '}
					vom 20. April 2026. Für verbindliche Informationen gilt die Botschaft bzw. die{' '}
					<a href={OFFICIAL_SITE_URL} target="_blank" rel="noopener">
						offizielle Gemeinde-Website
					</a>.
				</p>
			</div>
		</footer>
	</body>
</html>
