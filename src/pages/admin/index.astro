---
// Internal tool, not part of the public site: no Layout, no nav, kept out
// of search engines. Protected by Cloudflare Access, not by this page (see
// README section "Admin panel") – anyone who reaches this URL without
// passing Access will still hit a 403 from /api/admin/stories.
---

<!doctype html>
<html lang="de-CH">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Admin · Stories</title>
		<style is:global>
			:root {
				color-scheme: light;
				--border: #bbb;
				--bg-alt: #eee;
				--pending: #b45309;
				--approved: #15803d;
				--rejected: #b91c1c;
			}
			* {
				box-sizing: border-box;
			}
			body {
				margin: 0;
				padding: 1.5rem;
				font-family: system-ui, sans-serif;
				background: #fff;
				color: #111;
			}
			h1 {
				font-size: 1.25rem;
				margin: 0 0 1rem;
			}
			#status-message {
				margin-bottom: 1rem;
				font-size: 0.9rem;
			}
			#status-message[data-kind='error'] {
				color: var(--rejected);
			}
			table {
				width: 100%;
				border-collapse: collapse;
				font-size: 0.9rem;
				border-top: 1px solid var(--border);
			}
			th,
			td {
				border-bottom: 1px solid var(--border);
				padding: 0.6rem 0.5rem;
				text-align: left;
				vertical-align: top;
			}
			th {
				background: var(--bg-alt);
				border-bottom: 2px solid #888;
				position: sticky;
				top: 0;
			}
			tbody tr:nth-child(even) {
				background: #f2f2f2;
			}
			tr.is-updating {
				opacity: 0.5;
			}
			td.text-cell {
				white-space: pre-wrap;
				max-width: 32rem;
			}
			td.date-cell {
				white-space: nowrap;
				color: #555;
			}
			td.date-cell .time-part {
				color: #888;
				font-size: 0.85em;
			}
			td.ip-cell {
				white-space: nowrap;
				font-family: ui-monospace, monospace;
				color: #555;
			}
			select {
				font: inherit;
				padding: 0.35rem 0.5rem;
				border: 1px solid #ccc;
				border-radius: 4px;
				background: #fff;
				cursor: pointer;
			}
			select:hover {
				border-color: #999;
			}
			select:focus-visible {
				outline: 2px solid #666;
				outline-offset: 1px;
			}
			select.status-pending {
				color: var(--pending);
				border-color: var(--pending);
			}
			select.status-approved {
				color: var(--approved);
				border-color: var(--approved);
			}
			select.status-rejected {
				color: var(--rejected);
				border-color: var(--rejected);
			}
			td.action-cell {
				white-space: nowrap;
			}
			td.action-cell button + button {
				margin-left: 0.4rem;
			}
			button.edit-button,
			button.cancel-button {
				font: inherit;
				padding: 0.35rem 0.7rem;
				border: 1px solid #888;
				color: #333;
				background: #fff;
				border-radius: 4px;
				cursor: pointer;
				transition: background-color 0.15s ease, color 0.15s ease;
			}
			button.edit-button:hover,
			button.cancel-button:hover {
				background: #333;
				color: #fff;
			}
			button.save-button {
				font: inherit;
				padding: 0.35rem 0.7rem;
				border: 1px solid var(--approved);
				color: #fff;
				background: var(--approved);
				border-radius: 4px;
				cursor: pointer;
			}
			button.save-button:hover {
				filter: brightness(1.1);
			}
			button:disabled {
				opacity: 0.5;
				cursor: default;
			}
			button:focus-visible,
			input:focus-visible,
			textarea:focus-visible {
				outline: 2px solid #666;
				outline-offset: 1px;
			}
			input.name-input,
			textarea.text-input {
				font: inherit;
				width: 100%;
				padding: 0.35rem 0.5rem;
				border: 1px solid #999;
				border-radius: 4px;
				background: #fff;
			}
			textarea.text-input {
				min-width: 24rem;
				min-height: 10rem;
				resize: vertical;
			}
			.char-count {
				margin-top: 0.25rem;
				font-size: 0.8rem;
				color: #666;
			}
			.char-count.is-over {
				color: var(--rejected);
			}
			button.delete-button {
				font: inherit;
				padding: 0.35rem 0.7rem;
				border: 1px solid var(--rejected);
				color: var(--rejected);
				background: #fff;
				border-radius: 4px;
				cursor: pointer;
				transition: background-color 0.15s ease, color 0.15s ease;
			}
			button.delete-button:hover {
				background: var(--rejected);
				color: #fff;
			}
			button.delete-button:focus-visible {
				outline: 2px solid #666;
				outline-offset: 1px;
			}
		</style>
	</head>
	<body>
		<h1>Stories – Übersicht</h1>
		<p id="status-message">Lade …</p>
		<table hidden id="stories-table">
			<thead>
				<tr>
					<th>Datum</th>
					<th>Name</th>
					<th>IP</th>
					<th>Text</th>
					<th>Status</th>
					<th></th>
				</tr>
			</thead>
			<tbody id="stories-body"></tbody>
		</table>

		<script>
			const statusMessage = document.getElementById('status-message')!;
			const table = document.getElementById('stories-table')!;
			const tbody = document.getElementById('stories-body')!;

			// Keep in sync with MAX_NAME_LENGTH / MAX_TEXT_LENGTH in worker/index.js.
			const MAX_NAME_LENGTH = 80;
			const MAX_TEXT_LENGTH = 1500;

			function setMessage(text: string, kind?: 'error') {
				statusMessage.textContent = text;
				if (kind) statusMessage.setAttribute('data-kind', kind);
				else statusMessage.removeAttribute('data-kind');
			}

			function toDate(value: string) {
				return new Date(value.replace(' ', 'T') + 'Z');
			}

			function formatDatePart(value: string) {
				return toDate(value).toLocaleDateString('de-CH', { dateStyle: 'medium' });
			}

			function formatTimePart(value: string) {
				return toDate(value).toLocaleTimeString('de-CH', { timeStyle: 'short' }) + ' Uhr';
			}

			type Story = {
				id: number;
				created_at: string;
				name: string | null;
				text: string;
				status: 'pending' | 'approved' | 'rejected';
				ip: string;
			};

			function renderRow(story: Story): HTMLTableRowElement {
				const row = document.createElement('tr');
				row.dataset.id = String(story.id);

				const dateCell = document.createElement('td');
				dateCell.className = 'date-cell';
				const dateLine = document.createElement('div');
				dateLine.textContent = formatDatePart(story.created_at);
				const timeLine = document.createElement('div');
				timeLine.className = 'time-part';
				timeLine.textContent = formatTimePart(story.created_at);
				dateCell.append(dateLine, timeLine);

				const nameCell = document.createElement('td');
				nameCell.textContent = story.name || '–';

				const ipCell = document.createElement('td');
				ipCell.className = 'ip-cell';
				ipCell.textContent = story.ip;

				const textCell = document.createElement('td');
				textCell.className = 'text-cell';
				textCell.textContent = story.text;

				const statusCell = document.createElement('td');
				const select = document.createElement('select');
				select.className = `status-${story.status}`;
				select.dataset.previousValue = story.status;
				for (const value of ['pending', 'approved', 'rejected'] as const) {
					const option = document.createElement('option');
					option.value = value;
					option.textContent = value;
					if (value === story.status) option.selected = true;
					select.appendChild(option);
				}
				select.addEventListener('change', () => updateStatus(story, select));
				statusCell.appendChild(select);

				const actionCell = document.createElement('td');
				actionCell.className = 'action-cell';
				const editButton = document.createElement('button');
				editButton.type = 'button';
				editButton.className = 'edit-button';
				editButton.textContent = 'Bearbeiten';
				editButton.addEventListener('click', () => startEditing(story, row));
				actionCell.appendChild(editButton);

				const deleteButton = document.createElement('button');
				deleteButton.type = 'button';
				deleteButton.className = 'delete-button';
				deleteButton.textContent = 'Löschen';
				deleteButton.addEventListener('click', () => deleteStory(story.id, row));
				actionCell.appendChild(deleteButton);

				row.append(dateCell, nameCell, ipCell, textCell, statusCell, actionCell);
				return row;
			}

			function startEditing(story: Story, row: HTMLTableRowElement) {
				const [, nameCell, , textCell, , actionCell] = row.children as unknown as HTMLTableCellElement[];

				const nameInput = document.createElement('input');
				nameInput.type = 'text';
				nameInput.className = 'name-input';
				nameInput.maxLength = MAX_NAME_LENGTH;
				nameInput.placeholder = 'Anonym';
				nameInput.value = story.name ?? '';
				nameCell.replaceChildren(nameInput);

				const textInput = document.createElement('textarea');
				textInput.className = 'text-input';
				textInput.value = story.text;
				const charCount = document.createElement('div');
				charCount.className = 'char-count';
				const updateCharCount = () => {
					charCount.textContent = `${textInput.value.length} / ${MAX_TEXT_LENGTH} Zeichen`;
					charCount.classList.toggle('is-over', textInput.value.length > MAX_TEXT_LENGTH);
				};
				textInput.addEventListener('input', updateCharCount);
				updateCharCount();
				textCell.classList.remove('text-cell');
				textCell.replaceChildren(textInput, charCount);

				const saveButton = document.createElement('button');
				saveButton.type = 'button';
				saveButton.className = 'save-button';
				saveButton.textContent = 'Speichern';

				const cancelButton = document.createElement('button');
				cancelButton.type = 'button';
				cancelButton.className = 'cancel-button';
				cancelButton.textContent = 'Abbrechen';
				cancelButton.addEventListener('click', () => row.replaceWith(renderRow(story)));

				saveButton.addEventListener('click', async () => {
					saveButton.disabled = cancelButton.disabled = true;
					row.classList.add('is-updating');
					try {
						const res = await fetch(`/api/admin/stories/${story.id}`, {
							method: 'PATCH',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ name: nameInput.value, text: textInput.value }),
						});
						const data = await res.json().catch(() => ({}));
						if (!res.ok) throw new Error(data.error || res.statusText);
						row.replaceWith(renderRow(data.story as Story));
						setMessage('Änderungen gespeichert.');
					} catch (err) {
						row.classList.remove('is-updating');
						saveButton.disabled = cancelButton.disabled = false;
						setMessage(`Speichern fehlgeschlagen: ${(err as Error).message}`, 'error');
					}
				});

				actionCell.replaceChildren(saveButton, cancelButton);
				textInput.focus();
			}

			async function updateStatus(story: Story, select: HTMLSelectElement) {
				const row = select.closest('tr')!;
				const previousValue = select.dataset.previousValue!;
				row.classList.add('is-updating');
				try {
					const res = await fetch(`/api/admin/stories/${story.id}`, {
						method: 'PATCH',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ status: select.value }),
					});
					if (!res.ok) throw new Error((await res.json().catch(() => ({}))).error || res.statusText);
					select.className = `status-${select.value}`;
					select.dataset.previousValue = select.value;
					story.status = select.value as Story['status'];
				} catch (err) {
					select.value = previousValue;
					setMessage(`Status konnte nicht geändert werden: ${(err as Error).message}`, 'error');
				} finally {
					row.classList.remove('is-updating');
				}
			}

			async function deleteStory(id: number, row: HTMLTableRowElement) {
				if (!confirm('Diese Story wirklich unwiderruflich löschen?')) return;
				row.classList.add('is-updating');
				try {
					const res = await fetch(`/api/admin/stories/${id}`, { method: 'DELETE' });
					if (!res.ok) throw new Error((await res.json().catch(() => ({}))).error || res.statusText);
					row.remove();
				} catch (err) {
					row.classList.remove('is-updating');
					setMessage(`Löschen fehlgeschlagen: ${(err as Error).message}`, 'error');
				}
			}

			async function load() {
				try {
					const res = await fetch('/api/admin/stories');
					if (!res.ok) throw new Error((await res.json().catch(() => ({}))).error || res.statusText);
					const { stories } = (await res.json()) as { stories: Story[] };
					tbody.replaceChildren(...stories.map(renderRow));
					table.hidden = false;
					setMessage(`${stories.length} Stories geladen.`);
				} catch (err) {
					setMessage(`Konnte Stories nicht laden: ${(err as Error).message}`, 'error');
				}
			}

			load();
		</script>
	</body>
</html>
