---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title="Blog" description="Neuigkeiten und Statements von Pro Schulraum Wangen.">
	<section class="hero">
		<div class="wrap">
			<h1>Blog</h1>
			<p class="tagline">Neuigkeiten, Statements und Berichte rund um die Abstimmung.</p>
		</div>
	</section>

	<section class="block">
		<div class="wrap">
			{
				posts.length > 0 ? (
					<div class="grid cols-2">
						{posts.map((post) => (
							<div class="card">
								<h3>
									<a href={`/blog/${post.id}/`}>{post.data.title}</a>
								</h3>
								<p class="post-meta">
									{post.data.date.toLocaleDateString('de-CH', {
										year: 'numeric',
										month: 'long',
										day: 'numeric',
									})}{' '}
									· {post.data.author}
								</p>
								{post.data.excerpt && <p>{post.data.excerpt}</p>}
							</div>
						))}
					</div>
				) : (
					<p class="empty-note">Noch keine Beiträge.</p>
				)
			}
		</div>
	</section>
</Layout>
