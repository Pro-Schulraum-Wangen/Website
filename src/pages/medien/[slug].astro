---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const letters = await getCollection('letters', ({ data }) => data.published);
	return letters.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const dateFormatter = new Intl.DateTimeFormat('de-CH', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout title={entry.data.title} description={entry.data.excerpt}>
	<section class="block">
		<div class="wrap narrow">
			<article class="prose">
				<p><a href="/medien/">← Alle Leserbriefe und Medien</a></p>
				<h1>{entry.data.title}</h1>
				<p class="letters-meta">
					{entry.data.author} · {dateFormatter.format(entry.data.date)}
				</p>
				{entry.data.image && (
					<figure style="margin: 0 0 2rem;">
						<Image
							src={entry.data.image}
							alt={entry.data.imageAlt ?? entry.data.title}
							width={1000}
							quality={70}
							format="webp"
							style="display: block; width: 100%; height: auto; box-shadow: 0 2px 8px rgba(26, 24, 3, 0.14);"
						/>
						{entry.data.imageAlt && (
							<figcaption style="margin-top: 0.8rem; font-size: 0.9rem; color: var(--color-text-muted);">
								{entry.data.imageAlt}
							</figcaption>
						)}
					</figure>
				)}
				<Content />
			</article>
		</div>
	</section>
</Layout>
