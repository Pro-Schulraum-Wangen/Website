---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { getSupporters } from '../../lib/supporters';

const { photo: withImage, names: withoutImage, count } = await getSupporters();
---

<Layout
	title="Weil uns Wangen am Herzen liegt"
	description="Einwohnerinnen und Einwohner von Wangen SZ, die sich für die neue Schulanlage «Am Buechberg» einsetzen."
>
	<section class="hero">
		<div class="wrap">
			<h1>Weil uns Wangen am Herzen liegt</h1>
			<p class="tagline">
				{count} Personen aus Wangen und der Umgebung unterstützen das Projekt bereits öffentlich.
				Darunter sind Einwohnerinnen und Einwohner, Vereinsmitglieder sowie Menschen, die die
				Anlagen nutzen oder sich für eine moderne Infrastruktur in Wangen einsetzen.
			</p>
			<div class="button-row">
				<a class="button primary" href="/mitmachen/">Auch dabei sein</a>
			</div>
		</div>
	</section>

	{
		withImage.length > 0 && (
			<section class="block">
				<div class="wrap">
					<div class="grid cols-5">
						{withImage.map((s) => (
							<div class="supporter-card">
								<div class="supporter-media">
									<Image
										src={s.data.image!}
										alt={s.data.name}
										width={300}
										height={300}
										fit="cover"
										position="center"
										format="webp"
									/>
								</div>
								<div class="body">
									<div class="name">{s.data.name}</div>
									{s.data.role && <div class="role">{s.data.role}</div>}
								</div>
							</div>
						))}
					</div>
				</div>
			</section>
		)
	}

	{
		withoutImage.length > 0 && (
			<section class="block">
				<div class="wrap">
					<h2>Weitere Unterstützer:innen</h2>
					<ul class="supporter-list">
						{withoutImage.map((s) => (
							<li>
								{s.name}
								{s.location && <span class="ort"> · {s.location}</span>}
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}

	{
		count === 0 && (
			<section class="block">
				<div class="wrap">
					<p class="empty-note">
						Noch keine Unterstützer:innen eingetragen.{' '}
						<a href="/mitmachen/">Melden Sie sich hier</a>.
					</p>
				</div>
			</section>
		)
	}
</Layout>
