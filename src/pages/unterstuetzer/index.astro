---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

const supporters = (await getCollection('supporters', ({ data }) => data.published)).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const withImage = supporters.filter((s) => s.data.image);
const withoutImage = supporters.filter((s) => !s.data.image);
---

<Layout
	title="Unterstützer:innen"
	description="Einwohnerinnen und Einwohner von Wangen SZ, die sich für die neue Schulanlage «Am Buechberg» einsetzen."
>
	<section class="hero">
		<div class="wrap">
			<h1>Unterstützer:innen</h1>
			<p class="tagline">
				{supporters.length} Personen aus Wangen unterstützen das Projekt bereits öffentlich.
			</p>
			<div class="button-row">
				<a class="button primary" href="/mitmachen/">Auch dabei sein</a>
			</div>
		</div>
	</section>

	{
		withImage.length > 0 && (
			<section class="block">
				<div class="wrap">
					<div class="grid cols-3">
						{withImage.map((s) => (
							<div class="supporter-card">
								<Image src={s.data.image!} alt={s.data.name} width={400} height={300} />
								<div class="body">
									<div class="name">{s.data.name}</div>
									{s.data.role && <div class="role">{s.data.role}</div>}
									{s.data.quote && <blockquote>«{s.data.quote}»</blockquote>}
								</div>
							</div>
						))}
					</div>
				</div>
			</section>
		)
	}

	{
		withoutImage.length > 0 && (
			<section class="block">
				<div class="wrap">
					<h2>Weitere Unterstützer:innen</h2>
					<ul class="supporter-list">
						{withoutImage.map((s) => (
							<li>{s.data.name}</li>
						))}
					</ul>
				</div>
			</section>
		)
	}

	{
		supporters.length === 0 && (
			<section class="block">
				<div class="wrap">
					<p class="empty-note">
						Noch keine Unterstützer:innen eingetragen. <a href="/mitmachen/">Melde dich hier</a>.
					</p>
				</div>
			</section>
		)
	}
</Layout>
