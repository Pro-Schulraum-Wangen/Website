---
import Layout from '../../layouts/Layout.astro';
import { CONTACT_EMAIL, DOCUMENTS, FLYER_PICKUP_EMAIL } from '../../consts';

// Sign-ups go to the worker (worker/index.js, /api/flyer) and are stored in
// Cloudflare D1. Only whether a street is taken is public, never who took it.

// keep in sync with FLYER_MAX_FIELD_LENGTH / FLYER_MAX_NOTE_LENGTH in worker/index.js
const MAX_FIELD_LENGTH = 100;
const MAX_NOTE_LENGTH = 500;
---

<Layout
	title="Flyer Nr. 2 verteilen"
	description="Helfen Sie mit, den zweiten Flyer zur Schulanlage «Am Buechberg» in Wangen, Nuolen und Siebnen-Wangen zu verteilen. Wählen Sie Ihre Strassen und tragen Sie sich ein."
>
	<section class="hero">
		<div class="wrap narrow">
			<h1>Flyer Nr. 2 verteilen</h1>
			<p class="tagline">
				Ab dem 31. Oktober haben wir bereits unseren{' '}
				<a href={DOCUMENTS.flyer1} target="_blank" rel="noopener">ersten Flyer</a> mit allgemeinen
				Informationen zur Kampagne und unseren Unterstützer:innen verteilt. Herzlichen Dank allen,
				die mitgeholfen haben! Jetzt folgt der{' '}
				<a href={DOCUMENTS.flyer2} target="_blank" rel="noopener">zweite Flyer</a> (auch als Bild:{' '}
				<a href={DOCUMENTS.flyer2Seite1} target="_blank" rel="noopener">Seite 1</a>,{' '}
				<a href={DOCUMENTS.flyer2Seite2} target="_blank" rel="noopener">Seite 2</a>): Er zeigt, was ein{' '}
				<a href="/#kosten-ja-nein">Nein am 29. November kosten würde</a>.
			</p>
			<p class="tagline">
				Damit auch der zweite Flyer möglichst alle Haushalte in Wangen erreicht, verteilen wir ihn
				wieder gemeinsam. Alle Strassen sind dafür wieder frei. Wählen Sie eine oder mehrere
				Strassen, am liebsten in Ihrer Nähe, und tragen Sie sich ein. Gerne auch wieder dieselben
				Strassen wie beim ersten Mal.
			</p>
			<p class="tagline">
				Uns ist bewusst, dass nicht alle in der Öffentlichkeit stehen möchten. Das Flyerverteilen ist
				eine gute Möglichkeit, trotzdem mitzuhelfen. Es sind die stillen Helferinnen und Helfer, die
				für uns enorm wichtig sind. Die Namen der Verteilerinnen und Verteiler werden nicht
				veröffentlicht.
			</p>
			<p class="tagline">
				Die Flyer können Sie bei Raphael Seunig an der Schürwiesstrasse 10 in Wangen abholen: am{' '}
				<strong>Samstag, 7. November, von 9 bis 11 Uhr</strong> oder nach Vereinbarung per E-Mail
				an <a href={`mailto:${FLYER_PICKUP_EMAIL}`}>{FLYER_PICKUP_EMAIL}</a>. Wir kontaktieren Sie
				nach Ihrer Anmeldung.
			</p>
		</div>
	</section>

	<section class="block flyer">
		<div class="wrap">
			<div class="flyer-status" data-flyer-status role="status">
				<p class="stories-loading" data-flyer-loading>
					<span class="spinner" aria-hidden="true"></span>
					Strassen werden geladen …
				</p>
				<div class="stories-error" data-flyer-error hidden>
					<p>Die Strassen konnten leider nicht geladen werden.</p>
					<button class="button" type="button" data-flyer-retry>Erneut versuchen</button>
				</div>
			</div>

			<div class="flyer-done" data-flyer-done hidden>
				<h2>Alle Strassen sind vergeben!</h2>
				<p>
					Dank Ihrer phänomenalen Hilfe hat jede Strasse in Wangen, Nuolen und Siebnen-Wangen eine
					Verteilerin oder einen Verteiler gefunden. Herzlichen Dank allen, die mitmachen: Sie sorgen
					dafür, dass die Schulanlage «Am Buechberg» in jedem Briefkasten ankommt.
				</p>
				<p>
					Falls jemand ausfällt, werden einzelne Strassen wieder frei. Schauen Sie gerne später nochmals
					vorbei, oder schreiben Sie uns an <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>,
					wenn Sie bei Bedarf einspringen möchten.
				</p>
			</div>

			<div class="flyer-layout" data-flyer-content hidden>
				<div class="flyer-map-column">
					<div class="flyer-map" data-flyer-map aria-label="Karte der Strassen in Wangen"></div>
					<ul class="flyer-legend" aria-label="Legende">
						<li><span class="flyer-swatch is-free" aria-hidden="true"></span> noch frei</li>
						<li><span class="flyer-swatch is-selected" aria-hidden="true"></span> Ihre Auswahl</li>
						<li><span class="flyer-swatch is-taken" aria-hidden="true"></span> bereits vergeben</li>
					</ul>
					<p class="flyer-progress" data-flyer-progress></p>
					<p class="flyer-source">
						Die Anzahl Briefkästen ist geschätzt: Sie entspricht der Anzahl Wohnungen pro Strasse
						gemäss dem{' '}
						<a href="https://www.housing-stat.ch/" target="_blank" rel="noopener">Gebäude- und Wohnungsregister des Bundes</a>.
					</p>
				</div>

				<div class="flyer-list-column">
					<label class="flyer-filter-label" for="flyer-filter">Strasse suchen</label>
					<input
						id="flyer-filter"
						class="flyer-filter"
						type="search"
						placeholder="z. B. Zürcherstrasse"
						autocomplete="off"
						data-flyer-filter
					/>
					<fieldset class="flyer-status-filter" aria-label="Strassen anzeigen" data-flyer-status-filter>
						<label><input type="radio" name="flyer-status" value="all" checked /> Alle</label>
						<label><input type="radio" name="flyer-status" value="free" /> Noch frei</label>
						<label><input type="radio" name="flyer-status" value="taken" /> Vergeben</label>
					</fieldset>
					<ul class="flyer-streets" data-flyer-streets></ul>
				</div>
			</div>
		</div>

		<div class="wrap narrow">
			<form class="story-form flyer-form" data-flyer-form novalidate hidden>
				<h2>Ich übernehme …</h2>
				<p class="flyer-selection" data-flyer-selection aria-live="polite">
					Noch keine Strasse ausgewählt. Wählen Sie oben in der Liste oder auf der Karte.
				</p>
				<div class="flyer-nudge" data-flyer-nudge aria-live="polite">
					<p data-flyer-nudge-text>
						Wir sind um jede Strasse dankbar. Wenn Sie gleich mehrere übernehmen können, ist das
						natürlich noch besser.
					</p>
					<div class="flyer-nudge-suggestions" data-flyer-suggestions hidden></div>
				</div>

				<div class="flyer-fields">
					<div>
						<label for="flyer-first-name">Vorname</label>
						<input
							id="flyer-first-name"
							name="first_name"
							type="text"
							maxlength={MAX_FIELD_LENGTH}
							autocomplete="given-name"
							required
						/>
					</div>
					<div>
						<label for="flyer-last-name">Nachname</label>
						<input
							id="flyer-last-name"
							name="last_name"
							type="text"
							maxlength={MAX_FIELD_LENGTH}
							autocomplete="family-name"
							required
						/>
					</div>
					<div>
						<label for="flyer-email">E-Mail</label>
						<input
							id="flyer-email"
							name="email"
							type="email"
							maxlength={MAX_FIELD_LENGTH}
							autocomplete="email"
							required
						/>
					</div>
					<div>
						<label for="flyer-phone">Telefon</label>
						<input
							id="flyer-phone"
							name="phone"
							type="tel"
							maxlength={MAX_FIELD_LENGTH}
							autocomplete="tel"
							placeholder="079 123 45 67"
							required
						/>
					</div>
					<div>
						<label for="flyer-street">Strasse und Nr.</label>
						<input
							id="flyer-street"
							name="street"
							type="text"
							maxlength={MAX_FIELD_LENGTH}
							autocomplete="street-address"
							required
						/>
					</div>
					<div>
						<label for="flyer-zip-city">PLZ und Ort</label>
						<input
							id="flyer-zip-city"
							name="zip_city"
							type="text"
							maxlength={MAX_FIELD_LENGTH}
							placeholder="8855 Wangen"
							required
						/>
					</div>
				</div>

				<label for="flyer-note">Bemerkung <span class="optional">(freiwillig)</span></label>
				<textarea
					id="flyer-note"
					name="note"
					rows="3"
					maxlength={MAX_NOTE_LENGTH}
					placeholder="z. B. nur ein Teil der Strasse, Abholung nach Vereinbarung …"
				></textarea>

				{/* Honeypot – hidden from people, bots tend to fill it in */}
				<div class="story-hp" aria-hidden="true">
					<label for="flyer-website">Website</label>
					<input id="flyer-website" name="website" type="text" tabindex="-1" autocomplete="off" />
				</div>

				<label class="story-consent">
					<input type="checkbox" name="consent" required />
					<span>
						Ich bin einverstanden, dass meine Angaben zur Organisation der Flyer-Verteilung gespeichert
						werden. Öffentlich sichtbar ist nur, dass die Strasse vergeben ist, nicht von wem. Mehr dazu
						in der <a href="/datenschutz/">Datenschutzerklärung</a>.
					</span>
				</label>

				<button class="button primary" type="submit">Eintragen</button>
				<p class="story-message" data-flyer-message role="status" hidden></p>
			</form>

			<p class="flyer-contact">
				Fragen oder lieber ein ganzes Quartier? Schreiben Sie uns an{' '}
				<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
			</p>
		</div>
	</section>
</Layout>

<script>
	import L from 'leaflet';
	import 'leaflet/dist/leaflet.css';
	import type { GeoJsonObject } from 'geojson';

	type Street = {
		id: number;
		name: string;
		zip: string | null;
		// dwellings (≈ letterboxes) from the federal building register, null = unknown
		households: number | null;
		geometry: GeoJsonObject | null;
		taken: boolean;
	};

	const number = new Intl.NumberFormat('de-CH');

	function householdsLabel(street: Street) {
		if (street.households === null) return '';
		if (street.households === 0) return 'keine Wohnungen';
		return `ca. ${number.format(street.households)} ${street.households === 1 ? 'Briefkasten' : 'Briefkästen'}`;
	}

	function sumHouseholds(list: Street[]) {
		return list.reduce((sum, s) => sum + (s.households ?? 0), 0);
	}

	const TOWNS: Record<string, string> = { '8853': 'Lachen SZ', '8854': 'Siebnen', '8855': 'Wangen SZ' };

	const status = document.querySelector<HTMLElement>('[data-flyer-status]')!;
	const loading = document.querySelector<HTMLElement>('[data-flyer-loading]')!;
	const loadError = document.querySelector<HTMLElement>('[data-flyer-error]')!;
	const content = document.querySelector<HTMLElement>('[data-flyer-content]')!;
	const done = document.querySelector<HTMLElement>('[data-flyer-done]')!;
	const mapElement = document.querySelector<HTMLElement>('[data-flyer-map]')!;
	const progress = document.querySelector<HTMLElement>('[data-flyer-progress]')!;
	const filter = document.querySelector<HTMLInputElement>('[data-flyer-filter]')!;
	const statusFilter = document.querySelector<HTMLFieldSetElement>('[data-flyer-status-filter]')!;
	const list = document.querySelector<HTMLUListElement>('[data-flyer-streets]')!;
	const form = document.querySelector<HTMLFormElement>('[data-flyer-form]')!;
	const selectionText = document.querySelector<HTMLElement>('[data-flyer-selection]')!;
	const nudgeText = document.querySelector<HTMLElement>('[data-flyer-nudge-text]')!;
	const suggestions = document.querySelector<HTMLElement>('[data-flyer-suggestions]')!;
	const message = document.querySelector<HTMLElement>('[data-flyer-message]')!;
	const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

	let streets: Street[] = [];
	const selected = new Set<number>();
	const layers = new Map<number, L.GeoJSON>();
	const checkboxes = new Map<number, HTMLInputElement>();

	// Colours match the legend swatches in global.css.
	const STYLE = {
		free: { color: '#1f5fa8', weight: 4, opacity: 0.75, fillOpacity: 0.15 },
		selected: { color: '#c9a800', weight: 7, opacity: 1, fillOpacity: 0.35 },
		taken: { color: '#15803d', weight: 4, opacity: 0.9, fillOpacity: 0.2 },
	};

	const map = L.map(mapElement, { scrollWheelZoom: false }).setView([47.19, 8.89], 14);
	L.tileLayer('https://wmts.geo.admin.ch/1.0.0/ch.swisstopo.pixelkarte-grau/default/current/3857/{z}/{x}/{y}.jpeg', {
		maxZoom: 19,
		maxNativeZoom: 18,
		attribution: '&copy; <a href="https://www.swisstopo.admin.ch/" target="_blank" rel="noopener">swisstopo</a>',
	}).addTo(map);

	function googleMapsUrl(street: Street) {
		// Drop additions like «(Nr. 1–20)» that admins may add to split a street.
		const name = street.name.replace(/\s*\(.*\)\s*/g, ' ').trim();
		const zip = street.zip?.split(',')[0].trim();
		const place = zip ? `${zip} ${TOWNS[zip] ?? ''}`.trim() : 'Wangen SZ';
		return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${name}, ${place}`)}`;
	}

	function styleFor(street: Street) {
		if (street.taken) return STYLE.taken;
		return selected.has(street.id) ? STYLE.selected : STYLE.free;
	}

	function toggle(street: Street, on = !selected.has(street.id)) {
		if (street.taken) return;
		if (on) selected.add(street.id);
		else selected.delete(street.id);
		const checkbox = checkboxes.get(street.id);
		if (checkbox) checkbox.checked = on;
		checkbox?.closest('li')?.classList.toggle('is-selected', on);
		const layer = layers.get(street.id);
		if (layer) {
			layer.setStyle(styleFor(street));
			if (on) layer.bringToFront();
		}
		updateSelection();
	}

	function updateSelection() {
		const chosen = streets.filter((s) => selected.has(s.id));
		const names = chosen.map((s) => s.name);
		const total = sumHouseholds(chosen);
		selectionText.textContent =
			names.length === 0
				? 'Noch keine Strasse ausgewählt. Wählen Sie oben in der Liste oder auf der Karte.'
				: `${names.length === 1 ? '1 Strasse' : `${names.length} Strassen`}: ${names.join(', ')}` +
					(total > 0 ? ` – ca. ${number.format(total)} Briefkästen` : '');
		selectionText.classList.toggle('has-selection', names.length > 0);
		updateNudge(chosen);
	}

	// Free streets close to the ones already picked, to encourage taking on one more.
	const SUGGESTION_RADIUS_M = 600;
	const MAX_SUGGESTIONS = 3;

	function nearbyFreeStreets(chosen: Street[]) {
		const centers = chosen.flatMap((s) => {
			const layer = layers.get(s.id);
			return layer ? [layer.getBounds().getCenter()] : [];
		});
		if (centers.length === 0) return [];
		return streets
			.filter((s) => !s.taken && !selected.has(s.id) && layers.has(s.id))
			.map((s) => {
				const center = layers.get(s.id)!.getBounds().getCenter();
				return { street: s, distance: Math.min(...centers.map((c) => map.distance(c, center))) };
			})
			.filter((c) => c.distance <= SUGGESTION_RADIUS_M)
			.sort((a, b) => a.distance - b.distance)
			.slice(0, MAX_SUGGESTIONS)
			.map((c) => c.street);
	}

	function updateNudge(chosen: Street[]) {
		if (chosen.length === 0) {
			nudgeText.textContent =
				'Wir sind um jede Strasse dankbar. Wenn Sie gleich mehrere übernehmen können, ist das natürlich noch besser.';
		} else if (chosen.length === 1) {
			nudgeText.textContent =
				'Danke! Eine Strasse ist oft schnell verteilt. Mögen Sie noch eine zweite in der Nähe übernehmen?';
		} else if (chosen.length < 4) {
			nudgeText.textContent =
				'Super, herzlichen Dank! Je mehr Strassen pro Person, desto schneller erreicht der Flyer ganz Wangen.';
		} else {
			nudgeText.textContent = 'Phänomenal, vielen herzlichen Dank für Ihren grossen Einsatz!';
		}

		const nearby = chosen.length > 0 && chosen.length < 4 ? nearbyFreeStreets(chosen) : [];
		suggestions.hidden = nearby.length === 0;
		if (nearby.length === 0) {
			suggestions.replaceChildren();
			return;
		}
		const label = document.createElement('span');
		label.textContent = 'In der Nähe noch frei:';
		suggestions.replaceChildren(
			label,
			...nearby.map((street) => {
				const button = document.createElement('button');
				button.type = 'button';
				button.className = 'flyer-suggestion';
				const households = householdsLabel(street);
				button.textContent = `+ ${street.name}${households ? ` (${households})` : ''}`;
				button.addEventListener('click', () => toggle(street, true));
				return button;
			}),
		);
	}

	function renderList() {
		checkboxes.clear();
		list.replaceChildren(
			...streets.map((street) => {
				const li = document.createElement('li');
				li.dataset.name = street.name.toLocaleLowerCase('de-CH');
				li.classList.toggle('is-taken', street.taken);
				li.classList.toggle('is-selected', selected.has(street.id));

				const label = document.createElement('label');
				const checkbox = document.createElement('input');
				checkbox.type = 'checkbox';
				checkbox.disabled = street.taken;
				checkbox.checked = selected.has(street.id);
				checkbox.addEventListener('change', () => toggle(street, checkbox.checked));
				checkboxes.set(street.id, checkbox);
				const name = document.createElement('span');
				name.className = 'flyer-street-name';
				name.textContent = street.name;
				const text = document.createElement('span');
				text.className = 'flyer-street-text';
				text.append(name);
				const households = householdsLabel(street);
				if (households) {
					const count = document.createElement('span');
					count.className = 'flyer-households';
					count.textContent = households;
					text.append(count);
				}
				if (street.taken) {
					const badge = document.createElement('span');
					badge.className = 'flyer-badge';
					badge.textContent = '✓ vergeben';
					text.append(badge);
				}
				label.append(checkbox, text);

				const actions = document.createElement('span');
				actions.className = 'flyer-street-actions';
				if (layers.has(street.id)) {
					const show = document.createElement('button');
					show.type = 'button';
					show.textContent = 'Karte';
					show.title = `${street.name} auf der Karte zeigen`;
					show.addEventListener('click', () => {
						const layer = layers.get(street.id)!;
						map.fitBounds(layer.getBounds(), { maxZoom: 17, padding: [30, 30] });
						layer.openTooltip();
						mapElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
					});
					actions.append(show);
				}
				const google = document.createElement('a');
				google.href = googleMapsUrl(street);
				google.target = '_blank';
				google.rel = 'noopener';
				google.textContent = 'Google Maps';
				google.title = `${street.name} in Google Maps öffnen`;
				actions.append(google);

				li.append(label, actions);
				return li;
			}),
		);
		applyFilter();
	}

	function renderMap() {
		for (const layer of layers.values()) layer.remove();
		layers.clear();
		const all = L.featureGroup();
		for (const street of streets) {
			if (!street.geometry) continue;
			const layer = L.geoJSON(street.geometry, { style: () => styleFor(street) });
			const households = householdsLabel(street);
			layer.bindTooltip(
				`${street.name}${households ? ` (${households})` : ''}${street.taken ? ' – bereits vergeben' : ''}`,
				{ sticky: true },
			);
			layer.on('click', () => toggle(street));
			layer.addTo(map);
			all.addLayer(layer);
			layers.set(street.id, layer);
		}
		// Taken streets underneath, so free ones stay easy to click.
		for (const street of streets) if (!street.taken) layers.get(street.id)?.bringToFront();
		if (all.getLayers().length > 0) map.fitBounds(all.getBounds(), { padding: [10, 10] });
	}

	function applyFilter() {
		const query = filter.value.trim().toLocaleLowerCase('de-CH');
		const mode = statusFilter.querySelector<HTMLInputElement>('input:checked')?.value ?? 'all';
		for (const li of list.children as HTMLCollectionOf<HTMLLIElement>) {
			const taken = li.classList.contains('is-taken');
			li.hidden =
				(query !== '' && !li.dataset.name!.includes(query)) ||
				(mode !== 'all' && (mode === 'taken') !== taken);
		}
	}

	function updateProgress() {
		const taken = streets.filter((s) => s.taken);
		const total = sumHouseholds(streets);
		progress.textContent =
			`${taken.length} von ${streets.length} Strassen sind bereits vergeben` +
			(total > 0
				? ` (ca. ${number.format(sumHouseholds(taken))} von ${number.format(total)} Briefkästen).`
				: '.');
	}

	async function load() {
		status.hidden = false;
		loading.hidden = false;
		loadError.hidden = true;
		try {
			const res = await fetch('/api/flyer', { cache: 'no-store' });
			if (!res.ok) throw new Error(`HTTP ${res.status}`);
			streets = ((await res.json()) as { streets: Street[] }).streets;
			// Forget selections that someone else has taken in the meantime.
			for (const s of streets) if (s.taken) selected.delete(s.id);
			const allTaken = streets.length > 0 && streets.every((s) => s.taken);
			status.hidden = true;
			content.hidden = false;
			done.hidden = !allTaken;
			// Nothing left to pick, but keep the form while it shows the last thank-you.
			form.hidden = allTaken && message.hidden;
			// The map container was hidden until now, so Leaflet has to re-measure it.
			map.invalidateSize();
			renderMap();
			renderList();
			updateSelection();
			updateProgress();
		} catch {
			// API not reachable (also under `astro dev` without the worker).
			loading.hidden = true;
			loadError.hidden = false;
		}
	}

	const showMessage = (text: string, isError: boolean) => {
		message.textContent = text;
		message.classList.toggle('is-error', isError);
		message.hidden = false;
	};

	form.addEventListener('submit', async (e) => {
		e.preventDefault();
		const data = new FormData(form);
		const payload = {
			first_name: String(data.get('first_name') ?? '').trim(),
			last_name: String(data.get('last_name') ?? '').trim(),
			email: String(data.get('email') ?? '').trim(),
			phone: String(data.get('phone') ?? '').trim(),
			street: String(data.get('street') ?? '').trim(),
			zip_city: String(data.get('zip_city') ?? '').trim(),
			note: String(data.get('note') ?? ''),
			website: String(data.get('website') ?? ''),
			streets: [...selected],
		};

		if (selected.size === 0) {
			showMessage('Bitte wählen Sie mindestens eine Strasse aus.', true);
			return;
		}
		if (
			!payload.first_name ||
			!payload.last_name ||
			!payload.email ||
			!payload.phone ||
			!payload.street ||
			!payload.zip_city
		) {
			showMessage('Bitte füllen Sie alle Felder aus: Name, E-Mail, Telefon und Adresse.', true);
			return;
		}
		if (data.get('consent') !== 'on') {
			showMessage('Bitte bestätigen Sie die Einwilligung.', true);
			return;
		}

		submitButton.disabled = true;
		try {
			const res = await fetch('/api/flyer', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(payload),
			});
			const result = await res.json().catch(() => ({}));
			if (res.ok) {
				form.reset();
				selected.clear();
				showMessage(
					'Herzlichen Dank! Ihre Strassen sind für Sie reserviert. Wir melden uns bei Ihnen, um die Abholung der Flyer zu vereinbaren.',
					false,
				);
				await load();
			} else {
				showMessage(result.error ?? 'Das hat leider nicht geklappt. Bitte versuchen Sie es später nochmals.', true);
				// Someone was faster: reload so the taken streets show up as such.
				if (res.status === 409) await load();
			}
		} catch {
			showMessage('Das hat leider nicht geklappt. Bitte versuchen Sie es später nochmals.', true);
		} finally {
			submitButton.disabled = false;
		}
	});

	filter.addEventListener('input', applyFilter);
	statusFilter.addEventListener('change', applyFilter);
	document.querySelector('[data-flyer-retry]')?.addEventListener('click', () => load());

	load();
</script>
