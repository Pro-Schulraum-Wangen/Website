---
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { getSupporters } from '../lib/supporters';
import CostCalculator from '../components/CostCalculator.astro';
import { SITE_TAGLINE, VOTE_DATE_LABEL, DOCUMENTS, LUSTAT_KNUTWIL_URL } from '../consts';

import dorfplatzImg from '../assets/visualizations/dorfplatz-primarschule.jpg';
import sportanlageImg from '../assets/visualizations/sportanlage-turnhalle.jpg';
import klassenzimmerImg from '../assets/visualizations/klassenzimmer-interior.jpg';
import turnhalleImg from '../assets/visualizations/turnhalle-interior.jpg';
import situationsplanImg from '../assets/visualizations/situationsplan.jpg';

// Used as a CSS background-image on the hero section (needs a plain URL,
// not an <img> element, so we go through getImage() instead of <Image>).
const heroBg = await getImage({
	src: dorfplatzImg,
	width: 1920,
	height: 960,
	position: 'attention',
	quality: 65,
});

const allArguments = (await getCollection('arguments', ({ data }) => data.published)).sort(
	(a, b) => a.data.order - b.data.order,
);
const topArguments = allArguments.slice(0, 4);

const { photo: photoSupporters, count: supporterCount } = await getSupporters();

// Placeholder: facts and claims about the school building project.
// Text and images are placeholders and still need to be replaced with
// the details from the municipal council's official message (Botschaft).
const claims: { claim: string; body: string; image?: typeof situationsplanImg }[] = [
	{
		claim: '«Wangen wäre eine der am höchsten verschuldeten Gemeinden der ganzen Schweiz.»',
		body: `
			<p>
				Die SVP Wangen schreibt im <a href="${DOCUMENTS.marchanzeigerSvpNein}" target="_blank" rel="noopener">March-Anzeiger vom 4. September 2026</a>, dass Wangen nach den geplanten Investitionen gemessen an der
				Verschuldung pro Einwohner «eine der am höchsten verschuldeten
				Gemeinden in der ganzen Schweiz» wäre.
			</p>
			<p>
				<strong>Der Hinweis auf die steigende Verschuldung ist berechtigt.</strong>
				Die Investitionen sind gross und Wangen wird dafür Schulden aufnehmen
				müssen. Eine hohe Verschuldung bedeutet aber nicht automatisch, dass
				eine Gemeinde ein strukturelles Finanzproblem hat.
			</p>
			<p>
				Ein Blick in den <strong>Kanton Luzern</strong> zeigt das gut. Dort
				gelten Nettoschulden von mehr als <strong>CHF 2'500 pro Einwohner</strong>
				bereits als hoch. Trotzdem lagen 2024 zwölf Gemeinden darüber. <a href="${LUSTAT_KNUTWIL_URL}" target="_blank" rel="noopener">Knutwil wies mit <strong>CHF 7'259 pro Einwohner</strong> den höchsten Wert auf</a>.
				Dort ist die hohe Verschuldung ebenfalls wesentlich auf grosse
				Investitionen in die Infrastruktur zurückzuführen und soll nach Abschluss
				dieser Bautätigkeit wieder sinken.
			</p>
			<p>
				Auch im <strong>Kanton Schwyz</strong> verändern sich solche Werte
				stark. In der <a href="${DOCUMENTS.gemeindefinanzstatistik}" target="_blank" rel="noopener">Gemeindefinanzstatistik 2020</a> hatte Wangen eine
				Nettoschuld von <strong>CHF 1'122 pro Einwohner</strong>, Lachen dagegen
				<strong>CHF 5'644</strong>. Solche Werte sind Momentaufnahmen und können
				sich nach Phasen mit hohen Investitionen wieder deutlich verändern.
			</p>
			<p>
				<strong>
					Wangen hat kein strukturelles Finanzproblem. Die höhere Verschuldung
					entsteht durch Investitionen, denen mit der neuen Schul- und
					Sportanlage ein langfristiger Gegenwert gegenübersteht.
				</strong>
			</p>
		`,
	},
	{
		claim: '«Das Schulhaus 1 wird nach dem Neubau nicht mehr gebraucht und steht leer.»',
		body: 'Muss relativiert werden'
	},
	{
		claim: '«Die neue Turnhalle könnte genauso gut auf der Rickenbacherwiese gebaut werden.»',
		body: 'Hier im Idealfall beispiel aus WebGIS und Erklärung mit Fruchtfolgefläche'
	},
	{
		claim: '«Die Bevölkerung konnte bei der Planung des Projekts nicht mitreden.»',
		body: 'Auflisten wo man mitreden konnte und wer das alles gemacht hat.'
	},
	{
		claim: '«Es gibt bereits konkrete Alternativprojekte für die neue Schulanlage.»',
		body: 'https://www.primarschule-siebnen-wangen.ch/ und https://www.schule-wangen.ch/ sind keine Projekte, auch wenn sie den Anschein machen.'
	},
	{
		claim: '«Die grosse Turnhalle wird nur für den Turnverein Wangen gebaut.»',
		body: 'Hallenbelegung und auch Red Devils, welche hier nicht trainieren können sowie Jugi, die jetzt schon in MPS traniert.'
	},
	{
		claim: '«Die Schülerzahlen werden stark zurückgehen und es braucht künftig deutlich weniger Schulraum.»',
		body: 'Auch wenn es immer weniger Kinder gibt pro Frau, steigt die Bevölkerung in Wangen. Belegen.'
	},
];
---

<Layout>
	<section class="hero photo" style={`background-image: url(${heroBg.src});`}>
		<div class="wrap">
			<h1>Ja zur neuen Schulanlage «Am Buechberg»</h1>
			<p class="tagline">{SITE_TAGLINE}</p>
			<p class="tagline">{VOTE_DATE_LABEL}</p>
			<div class="button-row">
				<a class="button primary" href="/argumente/">Argumente ansehen</a>
				<a class="button secondary" href="/mitmachen/">Unterstützer:in werden</a>
			</div>
			{
				supporterCount > 0 && (
					<p class="hero-meta">
						Bereits <a href="/unterstuetzer/">{supporterCount} Unterstützer:innen</a> aus Wangen
						stehen öffentlich hinter dem Projekt.
					</p>
				)
			}
		</div>
	</section>

	<section class="block">
		<div class="wrap">
			<div class="section-head">
				<h2>Weshalb Ja?</h2>
				<a class="more" href="/argumente/">Alle Argumente →</a>
			</div>
			<div class="grid cols-4">
				{
					topArguments.map((arg) => (
						<div class="card">
							<h3>{arg.data.title}</h3>
							<p>{arg.data.summary}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="block alt">
		<div class="wrap">
			<div class="section-head">
				<h2>So soll es aussehen</h2>
			</div>
			<div class="gallery-grid">
				<figure>
					<Image src={sportanlageImg} alt="Visualisierung: Sportanlage mit neuer Dreifachturnhalle" width={640} height={480} quality={65} />
					<figcaption>Sportanlage mit der neuen Dreifachturnhalle</figcaption>
				</figure>
				<figure>
					<Image src={klassenzimmerImg} alt="Visualisierung: Klassenzimmer im Neubau" width={640} height={480} quality={65} />
					<figcaption>Ein Klassenzimmer im neuen Schulhaus</figcaption>
				</figure>
				<figure>
					<Image src={turnhalleImg} alt="Visualisierung: Innenansicht der Dreifachturnhalle" width={640} height={480} quality={65} />
					<figcaption>Innenansicht der Dreifachturnhalle</figcaption>
				</figure>
			</div>
			<figure class="gallery-full">
				<Image src={situationsplanImg} alt="Situationsplan der Schulanlage «Am Buechberg»" width={1500} quality={65} />
				<figcaption>Situationsplan: Schulhaus, Kindergarten, Turnhalle und Sportplätze</figcaption>
			</figure>
			<p class="image-credit">
				Visualisierungen aus der Präsentation der Informationsveranstaltung vom 20. April 2026.
				Quelle der Bilder: Halter AG, Max Dudler.
			</p>
		</div>
	</section>

	<section class="block">
		<div class="wrap narrow">
			<div class="claims">
				<div class="section-head">
					<h2>Fakten und Behauptungen zum Schulraumprojekt</h2>
				</div>
				<p class="tagline">
					Kritische Fragen und Bedenken gehören zum politischen Diskurs. Einige
					Aussagen rund um das Schulraumprojekt benötigen jedoch zusätzlichen Kontext.
					Hier ordnen wir sie sachlich ein.
				</p>
				<div class="claims-list">
					{
						claims.map((c) => (
							<details>
								<summary>{c.claim}</summary>
								<div class="claim-body">
									<div set:html={c.body} />
									{c.image && (
										<Image
											src={c.image}
											alt="Platzhalter-Visualisierung zum Schulraumprojekt"
											width={800}
											height={533}
											quality={65}
										/>
									)}
								</div>
							</details>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<CostCalculator />

	<section class="block">
		<div class="wrap">
			<div class="section-head">
				<h2>Unterstützer:innen aus Wangen</h2>
				<a class="more" href="/unterstuetzer/">
					Alle {supporterCount > 0 ? `${supporterCount} ` : ''}Unterstützer:innen →
				</a>
			</div>
			{
				photoSupporters.length > 0 ? (
					<div class="grid cols-5">
						{photoSupporters.map((s) => (
							<div class="supporter-card">
								{s.data.image && (
									<Image
										src={s.data.image}
										alt={s.data.name}
										width={300}
										height={300}
										fit="cover"
										position="center"
									/>
								)}
								<div class="body">
									<div class="name">{s.data.name}</div>
									{s.data.role && <div class="role">{s.data.role}</div>}
									{s.data.quote && <blockquote>«{s.data.quote}»</blockquote>}
								</div>
							</div>
						))}
					</div>
				) : (
					<p class="empty-note">
						Noch keine Unterstützer:innen mit Foto eingetragen. Seien Sie die erste Person –{' '}
						<a href="/mitmachen/">melden Sie sich hier</a>.
					</p>
				)
			}
		</div>
	</section>
</Layout>
