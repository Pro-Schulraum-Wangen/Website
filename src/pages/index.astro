---
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { getSupporters } from '../lib/supporters';
import CostCalculator from '../components/CostCalculator.astro';
import { SITE_TAGLINE, VOTE_DATE_LABEL } from '../consts';

import dorfplatzImg from '../assets/visualizations/dorfplatz-primarschule.jpg';
import sportanlageImg from '../assets/visualizations/sportanlage-turnhalle.jpg';
import klassenzimmerImg from '../assets/visualizations/klassenzimmer-interior.jpg';
import turnhalleImg from '../assets/visualizations/turnhalle-interior.jpg';
import situationsplanImg from '../assets/visualizations/situationsplan.jpg';

// Used as a CSS background-image on the hero section (needs a plain URL,
// not an <img> element, so we go through getImage() instead of <Image>).
const heroBg = await getImage({ src: dorfplatzImg, width: 1920, height: 960, position: 'attention' });

const allArguments = (await getCollection('arguments', ({ data }) => data.published)).sort(
	(a, b) => a.data.order - b.data.order,
);
const topArguments = allArguments.slice(0, 4);

const { photo: photoSupporters, count: supporterCount } = await getSupporters();

// Placeholder: facts and claims about the school building project.
// Text and images are placeholders and still need to be replaced with
// the details from the municipal council's official message (Botschaft).
const claims: { claim: string; body: string; image?: typeof situationsplanImg }[] = [
	{
		claim: 'Behauptung 1: «Die neue Schulanlage ist für Wangen viel zu teuer.»',
		body: 'Platzhalter: Hier folgt eine sachliche Einordnung der Kostenfrage mit Bezug zur Botschaft des Gemeinderates – Investitionssumme, Kostendach und die jährliche Belastung des Gemeindehaushalts.',
		image: situationsplanImg,
	},
	{
		claim: 'Behauptung 2: «Der bestehende Schulraum würde noch für Jahre ausreichen.»',
		body: 'Platzhalter: Kurzer Text zur heutigen Raumsituation, zu Provisorien und zur Auslastung der bestehenden Schulhäuser.',
	},
	{
		claim: 'Behauptung 3: «Eine Sanierung des alten Schulhauses wäre deutlich günstiger.»',
		body: 'Platzhalter: Text zum Vergleich Sanierung gegenüber Neubau, zu Bausubstanz und zu den langfristigen Betriebskosten.',
	},
	{
		claim: 'Behauptung 4: «Die Dreifachturnhalle ist überdimensioniert.»',
		body: 'Platzhalter: Text zum Bedarf von Schule und Vereinen, zu Belegungszeiten und zu kantonalen Vorgaben für Sportanlagen.',
		image: turnhalleImg,
	},
	{
		claim: 'Behauptung 5: «Der Standort «Am Buechberg» ist schlecht gewählt.»',
		body: 'Platzhalter: Text zur Lage, zur Erschliessung, zu den Schulwegen und zur Verfügbarkeit des Grundstücks.',
	},
	{
		claim: 'Behauptung 6: «Die Schülerzahlen steigen gar nicht so stark.»',
		body: 'Platzhalter: Text zur Bevölkerungs- und Schülerprognose für Wangen und zu den zugrunde liegenden Annahmen.',
		image: klassenzimmerImg,
	},
	{
		claim: 'Behauptung 7: «Das Projekt belastet die Gemeindefinanzen auf Jahre hinaus.»',
		body: 'Platzhalter: Text zu Finanzierung, Steuerfuss, Verschuldung und zum Investitionsplan der Gemeinde.',
	},
	{
		claim: 'Behauptung 8: «Ein Neubau ist ökologisch nicht vertretbar.»',
		body: 'Platzhalter: Text zu Energiestandard, Holzbau, Photovoltaik, grauer Energie und Aussenraumgestaltung.',
	},
	{
		claim: 'Behauptung 9: «Die Bauzeit führt zu jahrelangen Provisorien.»',
		body: 'Platzhalter: Text zum Bauablauf, zur voraussichtlichen Bauzeit und zum Schulbetrieb während der Bauphase.',
	},
	{
		claim: 'Behauptung 10: «Über das Projekt wurde zu wenig informiert.»',
		body: 'Platzhalter: Text zum bisherigen Mitwirkungsprozess, zu Informationsveranstaltungen und zu den öffentlich verfügbaren Unterlagen.',
	},
];
---

<Layout>
	<section class="hero photo" style={`background-image: url(${heroBg.src});`}>
		<div class="wrap">
			<h1>Ja zur neuen Schulanlage «Am Buechberg»</h1>
			<p class="tagline">{SITE_TAGLINE}</p>
			<p class="tagline">{VOTE_DATE_LABEL}</p>
			<div class="button-row">
				<a class="button primary" href="/argumente/">Argumente ansehen</a>
				<a class="button secondary" href="/mitmachen/">Unterstützer:in werden</a>
			</div>
			{
				supporterCount > 0 && (
					<p class="hero-meta">
						Bereits <a href="/unterstuetzer/">{supporterCount} Unterstützer:innen</a> aus Wangen
						stehen öffentlich hinter dem Projekt.
					</p>
				)
			}
		</div>
	</section>

	<section class="block">
		<div class="wrap">
			<div class="section-head">
				<h2>Weshalb Ja?</h2>
				<a class="more" href="/argumente/">Alle Argumente →</a>
			</div>
			<div class="grid cols-4">
				{
					topArguments.map((arg) => (
						<div class="card">
							<h3>{arg.data.title}</h3>
							<p>{arg.data.summary}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="block alt">
		<div class="wrap">
			<div class="section-head">
				<h2>So soll es aussehen</h2>
			</div>
			<div class="gallery-grid">
				<figure>
					<Image src={sportanlageImg} alt="Visualisierung: Sportanlage mit neuer Dreifachturnhalle" width={640} height={480} />
					<figcaption>Sportanlage mit der neuen Dreifachturnhalle</figcaption>
				</figure>
				<figure>
					<Image src={klassenzimmerImg} alt="Visualisierung: Klassenzimmer im Neubau" width={640} height={480} />
					<figcaption>Ein Klassenzimmer im neuen Schulhaus</figcaption>
				</figure>
				<figure>
					<Image src={turnhalleImg} alt="Visualisierung: Innenansicht der Dreifachturnhalle" width={640} height={480} />
					<figcaption>Innenansicht der Dreifachturnhalle</figcaption>
				</figure>
			</div>
			<figure class="gallery-full">
				<Image src={situationsplanImg} alt="Situationsplan der Schulanlage «Am Buechberg»" width={1500} />
				<figcaption>Situationsplan: Schulhaus, Kindergarten, Turnhalle und Sportplätze</figcaption>
			</figure>
			<p class="image-credit">
				Visualisierungen aus der Botschaft des Gemeinderates Wangen vom 11. Juni 2026. Quelle der
				Bilder: Halter AG, Max Dudler.
			</p>
		</div>
	</section>

	<section class="block">
		<div class="wrap narrow">
			<div class="claims">
				<div class="section-head">
					<h2>Fakten und Behauptungen zum Schulraumprojekt</h2>
				</div>
				<p class="tagline">
					Rund um das Projekt kursieren verschiedene Behauptungen. Hier ordnen wir die
					zehn häufigsten sachlich ein. (Platzhalter – Inhalte folgen.)
				</p>
				<div class="claims-list">
					{
						claims.map((c) => (
							<details>
								<summary>{c.claim}</summary>
								<div class="claim-body">
									<p>{c.body}</p>
									{c.image && (
										<Image
											src={c.image}
											alt="Platzhalter-Visualisierung zum Schulraumprojekt"
											width={800}
											height={533}
										/>
									)}
								</div>
							</details>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<CostCalculator />

	<section class="block">
		<div class="wrap">
			<div class="section-head">
				<h2>Unterstützer:innen aus Wangen</h2>
				<a class="more" href="/unterstuetzer/">
					Alle {supporterCount > 0 ? `${supporterCount} ` : ''}Unterstützer:innen →
				</a>
			</div>
			{
				photoSupporters.length > 0 ? (
					<div class="grid cols-5">
						{photoSupporters.map((s) => (
							<div class="supporter-card">
								{s.data.image && (
									<Image
										src={s.data.image}
										alt={s.data.name}
										width={300}
										height={300}
										fit="cover"
										position="center"
									/>
								)}
								<div class="body">
									<div class="name">{s.data.name}</div>
									{s.data.role && <div class="role">{s.data.role}</div>}
									{s.data.quote && <blockquote>«{s.data.quote}»</blockquote>}
								</div>
							</div>
						))}
					</div>
				) : (
					<p class="empty-note">
						Noch keine Unterstützer:innen mit Foto eingetragen. Seien Sie die erste Person –{' '}
						<a href="/mitmachen/">melden Sie sich hier</a>.
					</p>
				)
			}
		</div>
	</section>
</Layout>
