---
// Cost overview for the arguments page.
//
// Figures are taken from the municipal council's official message
// ("Botschaft Neubau Schulanlage Wangen «Am Buechberg»", 11 June 2026):
// - chapter 3 / 9.1 / 9.4: gross cost, cantonal contributions, net cost
// - chapter 9.8 to 9.10: planned tax-rate rise from 135 % to 150 %, the
//   resulting additional municipal tax per year by taxable income, and the
//   share of taxpayers per income bracket (cantonal tax statistics 2022).

import { DOCUMENTS, ESTV_CALCULATOR_URL } from '../consts';

const GROSS_COST = 55_600_000;
const CANTON_CONTRIBUTION = 5_600_000;
const NET_COST = GROSS_COST - CANTON_CONTRIBUTION;

const fmt = (n: number) => n.toLocaleString('de-CH');
const pct = (n: number) => n.toFixed(1) + ' %';

// Table from Botschaft chapter 9.10. `single` / `couple` are the maximum
// additional municipal tax per year at 2026 rates (without "Kultussteuer"); for
// the top bracket they are a minimum instead. `share` is the percentage of
// taxpayers in Wangen in 2022.
// The table lists 11.5 % for the 60k–80k bracket, the pie chart next to it
// 11.6 %; 11.5 % is used because it adds up to 100 % and matches the 77.8 %
// headline.
// `color` is a single-hue sequential ramp from campaign yellow (low income)
// to ink (high income), interpolated in OKLab.
const BRACKETS = [
	{ label: "CHF 0 bis 60'000", short: "bis 60'000", share: 66.3, single: 255, couple: 203, color: '#e4da22' },
	{ label: "CHF 60'001 bis 80'000", short: "60'001–80'000", share: 11.5, single: 371, couple: 301, color: '#c1b91d' },
	{ label: "CHF 80'001 bis 100'000", short: "80'001–100'000", share: 7.6, single: 488, couple: 407, color: '#9f9818' },
	{ label: "CHF 100'001 bis 120'000", short: "100'001–120'000", share: 4.8, single: 605, couple: 517, color: '#7f7913' },
	{ label: "CHF 120'001 bis 150'000", short: "120'001–150'000", share: 4.1, single: 780, couple: 693, color: '#605b0e' },
	{ label: "CHF 150'001 bis 250'000", short: "150'001–250'000", share: 3.8, single: 1365, couple: 1278, color: '#433f09' },
	{ label: "über CHF 250'000", short: "über 250'000", share: 1.9, single: 1365, couple: 1278, color: '#272505', atLeast: true },
];

// Upper bound of taxable income for each bracket; the last one is open-ended.
const BRACKET_MAXES = [60_000, 80_000, 100_000, 120_000, 150_000, 250_000];

const SHARE_UP_TO_80K = BRACKETS[0].share + BRACKETS[1].share;

// Donut geometry, computed at build time. Segments start at 12 o'clock and run
// clockwise in bracket order.
const SIZE = 200;
const CENTER = SIZE / 2;
const OUTER = 98;
const INNER = 58;
const totalShare = BRACKETS.reduce((sum, b) => sum + b.share, 0);

const point = (radius: number, angle: number) => {
	const a = angle - Math.PI / 2;
	return `${(CENTER + radius * Math.cos(a)).toFixed(3)} ${(CENTER + radius * Math.sin(a)).toFixed(3)}`;
};

let cursor = 0;
const segments = BRACKETS.map((b) => {
	const start = (cursor / totalShare) * 2 * Math.PI;
	cursor += b.share;
	const end = (cursor / totalShare) * 2 * Math.PI;
	const large = end - start > Math.PI ? 1 : 0;
	const d = [
		`M ${point(OUTER, start)}`,
		`A ${OUTER} ${OUTER} 0 ${large} 1 ${point(OUTER, end)}`,
		`L ${point(INNER, end)}`,
		`A ${INNER} ${INNER} 0 ${large} 0 ${point(INNER, start)}`,
		'Z',
	].join(' ');
	return { ...b, d };
});
---

<section class="block">
	<div class="wrap narrow">
		<div class="section-head">
			<h2>Was kostet mich das Projekt?</h2>
		</div>

		<ul class="cost-summary">
			<li>
				<span class="cost-summary-sign" aria-hidden="true"></span>
				<span class="cost-summary-label">Gesamtkosten (brutto, exkl. Teuerung)</span>
				<span class="cost-summary-value">CHF {fmt(GROSS_COST)}</span>
			</li>
			<li>
				<span class="cost-summary-sign" aria-hidden="true">−</span>
				<span class="cost-summary-label">erwartete Beiträge des Kantons Schwyz</span>
				<span class="cost-summary-value">CHF {fmt(CANTON_CONTRIBUTION)}</span>
			</li>
			<li class="cost-summary-total">
				<span class="cost-summary-sign" aria-hidden="true">=</span>
				<span class="cost-summary-label">Nettobelastung der Gemeinde Wangen</span>
				<span class="cost-summary-value">CHF {fmt(NET_COST)}</span>
			</li>
		</ul>

		<h3 class="cost-calc-title">Ihr persönlicher Anteil</h3>
		<p>
			Zur Finanzierung der Schulanlage und weiterer bereits geplanter Investitionen
			plant der Gemeinderat, den Steuerfuss ab 2028 von 135 % auf 150 % zu erhöhen –
			also zurück auf das Niveau von 2025. Die Tabelle unten zeigt, was das je nach
			steuerbarem Einkommen ungefähr kostet.
		</p>

		<details class="cost-calc-explainer">
			<summary>Was heisst «Steuerfuss 150 %»?</summary>
			<div class="cost-calc-explainer-body">
				<p>Ihre Einkommenssteuer besteht vereinfacht gesagt aus zwei Teilen.</p>
				<p>
					<strong>Zum einen gibt es die direkte Bundessteuer.</strong> Sie geht an den
					Bund und hat mit dieser Vorlage nichts zu tun.
				</p>
				<p>
					<strong>
						Zum anderen gibt es die Steuern für Kanton, Bezirk, Gemeinde und Kirche.
					</strong>{' '}
					Dafür wird zuerst aus Ihrem steuerbaren Einkommen ein Betrag berechnet, der
					als gemeinsame Referenz dient: die sogenannte <strong>einfache Steuer</strong>.
				</p>
				<p><strong>1. Die einfache Steuer ist der Referenzwert</strong></p>
				<p>
					Ein Beispiel: Wer rund CHF 55'000 pro Jahr verdient, hat nach den üblichen
					Abzügen vielleicht noch ein steuerbares Einkommen von rund CHF 40'000.
					Daraus ergibt sich beispielsweise eine einfache Steuer von CHF 1'000. Diese
					CHF 1'000 sind nun die Referenz für Kanton, Bezirk, Gemeinde und Kirche.
				</p>
				<p>
					Wer mehr verdient, hat auch eine höhere einfache Steuer, und zwar
					überproportional: Verdient jemand beispielsweise doppelt so viel, beträgt
					die einfache Steuer nicht einfach CHF 2'000, sondern vielleicht CHF 2'800.
					Das nennt man <strong>Progression</strong>: Je höher das Einkommen, desto
					höher ist auch der prozentuale Anteil, der als Steuer anfällt.
				</p>
				<p><strong>2. Der Steuerfuss bestimmt, wie viel davon bezahlt wird</strong></p>
				<p>
					Die einfache Steuer ist die{' '}
					<strong>gemeinsame Referenz im ganzen Kanton Schwyz</strong>. Alle
					Gemeinden berechnen ihren Steuerfuss auf derselben Grundlage.{' '}
					<strong>100 % entsprechen genau diesem Referenzwert.</strong> Gemeinden
					mit einem Steuerfuss von mehr als 100 % verlangen entsprechend mehr,
					Gemeinden mit einem Steuerfuss von weniger als 100 % entsprechend
					weniger.
				</p>
				<p>
					Dasselbe Prinzip gilt für Kanton, Bezirk und Kirche. Bei einer
					einfachen Steuer von CHF 1'000 sieht die Rechnung in Wangen heute so
					aus:
				</p>
				<div class="cost-calc-table-wrap">
					<table>
						<thead>
							<tr>
								<th>Geht an</th>
								<th>Steuerfuss</th>
								<th>Steuer</th>
							</tr>
						</thead>
						<tbody>
							<tr><td>Kanton Schwyz</td><td>110 %</td><td>CHF 1'100</td></tr>
							<tr><td>Bezirk March</td><td>30 %</td><td>CHF 300</td></tr>
							<tr><td>Gemeinde Wangen</td><td>135 %</td><td>CHF 1'350</td></tr>
							<tr><td>röm.-kath. Kirche</td><td>30 %</td><td>CHF 300</td></tr>
							<tr><td>evang.-ref. Kirche</td><td>14 %</td><td>CHF 140</td></tr>
						</tbody>
					</table>
				</div>
				<p>
					Die CHF 1'000 einfache Steuer werden also{' '}
					<strong>nicht zusätzlich bezahlt</strong>. Sie dienen lediglich als
					gemeinsame Berechnungsgrundlage.
				</p>
				<p>
					Mit der Schulraumvorlage steigt{' '}
					<strong>nur der Steuerfuss der Gemeinde Wangen von 135 % auf 150 %</strong>.
					Bei CHF 1'000 einfacher Steuer bedeutet das:
				</p>
				<ul>
					<li>Heute: CHF 1'350 an die Gemeinde</li>
					<li>Neu: CHF 1'500 an die Gemeinde</li>
					<li><strong>Mehrbelastung: CHF 150 pro Jahr</strong></li>
				</ul>
				<p>Kanton, Bezirk und Kirche bleiben unverändert.</p>
				<p>
					Die Erhöhung auf 150 % ist nicht auf Dauer festgeschrieben. Der
					Gemeinderat rechnet kurz- und mittelfristig mit diesem Steuerfuss, also
					für etwa 5 bis 10 Jahre. Wie hoch er danach sein wird, lässt sich heute
					nicht seriös vorhersagen. Das hängt unter anderem davon ab, wie sich die
					Bevölkerung, die Steuererträge und weitere Investitionen entwickeln. Der
					Steuerfuss wird deshalb jedes Jahr neu festgelegt.
				</p>
				<p>
					Im Kanton Schwyz liegt Wangen mit 150 % am oberen Ende (siehe{' '}
					<a href={DOCUMENTS.steuerfusstabelle} target="_blank" rel="noopener">
						Steuerfusstabelle des Kantons Schwyz
					</a>, Seite 2, Spalte «Gemeinde»). Schweizweit bleibt die Steuerbelastung
					jedoch vergleichsweise tief. Einen Vergleich liefert der{' '}
					<a href={ESTV_CALCULATOR_URL} target="_blank" rel="noopener">
						Steuerrechner der Eidgenössischen Steuerverwaltung
					</a>. Welche Mehrkosten die Erhöhung für Ihren Haushalt ungefähr bedeutet,
					zeigt die Tabelle unten.
				</p>
			</div>
		</details>

		<div class="cost-impact">
			<h4 class="cost-impact-title">
				Zusätzliche Gemeindesteuer pro Jahr bei einem Steuerfuss von 150 % statt 135 %
			</h4>
			<div class="cost-calc-table-wrap">
				<table class="cost-impact-table">
					<thead>
						<tr>
							<th scope="col">Steuerbares Einkommen</th>
							<th scope="col">Anteil Steuer&shy;pflichtige 2022</th>
							<th scope="col">Allein&shy;stehende 2026</th>
							<th scope="col">Ehepaare 2026</th>
						</tr>
					</thead>
					<tbody>
						{
							BRACKETS.map((b) => (
								<tr>
									<th scope="row">{b.label}</th>
									<td>{pct(b.share)}</td>
									<td>
										{b.atLeast ? 'ab' : 'bis'} CHF {fmt(b.single)}
									</td>
									<td>
										{b.atLeast ? 'ab' : 'bis'} CHF {fmt(b.couple)}
									</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
			<p class="cost-impact-note">
				Ohne Kultussteuer, Zahlen gerundet. Massgebend ist das steuerbare Einkommen
				nach allen Abzügen, nicht der Bruttolohn. Der Anteil Steuerpflichtige stammt
				aus der Steuerstatistik des Kantons Schwyz 2022, die Steuerbeträge beruhen auf
				den Tarifen 2026.
			</p>

			<figure class="cost-share">
				<svg
					class="cost-donut"
					viewBox={`0 0 ${SIZE} ${SIZE}`}
					role="img"
					aria-labelledby="cost-share-caption"
				>
					{
						segments.map((s, i) => (
							<path d={s.d} fill={s.color} data-index={i} data-value={pct(s.share)} data-label={s.short}>
								<title>
									{s.label}: {pct(s.share)} der Steuerpflichtigen
								</title>
							</path>
						))
					}
					<text class="cost-donut-value" x={CENTER} y={CENTER + 2} aria-hidden="true" />
					<text class="cost-donut-label" x={CENTER} y={CENTER + 20} aria-hidden="true" />
				</svg>
				<figcaption class="cost-share-body">
					<p class="cost-share-caption" id="cost-share-caption">
						Steuerpflichtige in Wangen nach steuerbarem Einkommen (2022)
					</p>
					<p class="cost-share-highlight">
						<strong>{pct(SHARE_UP_TO_80K)}</strong> der Steuerpflichtigen haben ein
						steuerbares Einkommen bis CHF 80'000. Für sie beträgt die Mehrbelastung
						höchstens CHF 371 (alleinstehend) bzw. CHF 301 (verheiratet) pro Jahr.
					</p>
					<ul class="cost-share-legend">
						{
							segments.map((s, i) => (
								<li data-index={i}>
									<span class="cost-share-swatch" style={`background: ${s.color}`} aria-hidden="true" />
									<span class="cost-share-label">{s.short}</span>
									<span class="cost-share-value">{pct(s.share)}</span>
								</li>
							))
						}
					</ul>
				</figcaption>
			</figure>
		</div>

		<h3 class="cost-calc-title">Grobe Einstufung für Ihren Haushalt</h3>
		<p>
			Wo ungefähr liegen Sie in der Tabelle? Der Rechner schätzt Ihr steuerbares
			Einkommen aus dem Bruttolohn und ordnet Sie der passenden Stufe zu.
		</p>
		<p class="cost-calc-warning">
			<strong>Bitte mit Vorsicht geniessen:</strong> Das ist nur eine grobe
			Einstufung auf Basis der Tabelle in der Botschaft der Gemeinde, keine
			Steuerberechnung. Das steuerbare Einkommen wird pauschal mit 80 % des
			Bruttolohns angenommen; Ihre tatsächlichen Abzüge (z. B. für Kinder) können
			stark davon abweichen. Ausgewiesen wird jeweils der Höchstbetrag der Stufe.
			Für steuerbare Einkommen über CHF 250'000 enthält die Botschaft keine
			genaueren Zahlen, der Rechner liefert dort keine hilfreiche Angabe.
		</p>

		<form
			class="cost-calc"
			id="cost-calc"
			novalidate
			data-brackets={JSON.stringify(BRACKETS.map(({ single, couple }) => ({ single, couple })))}
			data-maxes={JSON.stringify(BRACKET_MAXES)}
		>
			<div class="cost-calc-field">
				<span class="cost-calc-legend">Zivilstand</span>
				<div class="cost-calc-choice">
					<label><input type="radio" name="status" value="single" checked /> Alleinstehend</label>
					<label><input type="radio" name="status" value="couple" /> Verheiratet</label>
				</div>
			</div>

			<div class="cost-calc-row">
				<div class="cost-calc-field cost-calc-field-salary">
					<label for="calc-salary" id="calc-salary-label">Monatslohn (brutto), CHF</label>
					<input
						type="number"
						id="calc-salary"
						name="salary"
						inputmode="numeric"
						min="0"
						step="100"
						placeholder="z. B. 6500"
						required
					/>
				</div>

				<div class="cost-calc-field">
					<span class="cost-calc-legend" id="calc-months-legend">Auszahlungen pro Jahr</span>
					<div class="cost-calc-choice">
						<label><input type="radio" name="months" value="12" checked /> 12 ×</label>
						<label><input type="radio" name="months" value="13" /> 13 ×</label>
					</div>
				</div>
			</div>

			<div class="cost-calc-row" id="calc-partner-group" hidden>
				<div class="cost-calc-field cost-calc-field-salary">
					<label for="calc-salary-partner">Monatslohn Ehepartner:in (brutto), CHF</label>
					<input
						type="number"
						id="calc-salary-partner"
						name="salaryPartner"
						inputmode="numeric"
						min="0"
						step="100"
						placeholder="z. B. 6500 oder 0"
					/>
				</div>

				<div class="cost-calc-field">
					<span class="cost-calc-legend">Auszahlungen pro Jahr (Ehepartner:in)</span>
					<div class="cost-calc-choice">
						<label><input type="radio" name="monthsPartner" value="12" checked /> 12 ×</label>
						<label><input type="radio" name="monthsPartner" value="13" /> 13 ×</label>
					</div>
				</div>
			</div>

			<button type="submit" class="button primary" id="calc-submit" aria-disabled="true">Einstufen</button>
		</form>

		<div class="cost-calc-result" id="cost-calc-result" aria-live="polite" hidden>
			<p class="cost-calc-headline">Grobe Schätzung der zusätzlichen Gemeindesteuer pro Jahr</p>
			<p class="cost-calc-big">
				<span id="calc-out-added">…</span>
				<span class="cost-calc-big-label" id="calc-out-month-wrap">
					das sind bis zu <span id="calc-out-month">…</span> pro Monat
				</span>
			</p>
			<p class="cost-calc-note" id="calc-out-basis"></p>
			<p class="cost-calc-note" id="calc-out-top" hidden>
				Für steuerbare Einkommen über CHF 250'000 nennt die Botschaft nur diesen
				Mindestbetrag. Wie hoch die Mehrbelastung tatsächlich ist, lässt sich daraus
				nicht ableiten. Nutzen Sie dafür den{' '}
				<a href={ESTV_CALCULATOR_URL} target="_blank" rel="noopener">
					Steuerrechner der Eidgenössischen Steuerverwaltung
				</a>.
			</p>
			<p class="cost-calc-note">
				Nur eine grobe Einstufung auf Basis der Botschaft, keine Steuerberechnung.
			</p>
		</div>

		<div class="cost-value">
			<h3>Sie bekommen dafür einen Gegenwert</h3>
			<p>
				Dieser Betrag ist kein verlorenes Geld. Investitionen in die Gemeinde
				schaffen einen konkreten Gegenwert: gute Schulen, zeitgemässe Infrastruktur,
				attraktive öffentliche Räume und gute Bedingungen für Vereine und das
				Dorfleben. All das trägt dazu bei, dass Wangen auch langfristig ein
				attraktiver Wohn- und Lebensort bleibt.
			</p>
			<p>
				Von einer modernen Schul- und Sportanlage, neu gestalteten Aussenanlagen
				und besseren Räumen für die Vereine profitiert das ganze Dorf, auch wer keine
				schulpflichtigen Kinder hat.
			</p>
			<p>
				Und «einfach nichts tun» gibt es nicht: Gewisse Investitionen sind so oder so
				nötig. Ein Nein kostet die Gemeinde laut Botschaft des Gemeinderates über
				CHF 23 Mio. für Sanierungen der alten Gebäude, für Provisorien und durch den
				Verlust der zugesicherten Kantonsbeiträge. Die bestehenden Raumprobleme wären
				damit trotzdem nicht gelöst.
			</p>
		</div>

		<p class="cost-calc-disclaimer">
			Der Steuerfuss wird jährlich neu festgelegt; 150 % gilt voraussichtlich für rund
			5 bis 10 Jahre. Die Steuerfuss-Erhöhung finanziert die Schulanlage sowie weitere
			bereits geplante Investitionen. Quelle:{' '}
			<a href={DOCUMENTS.botschaft} target="_blank" rel="noopener">
				Botschaft des Gemeinderates Wangen
			</a>{' '}
			vom 11. Juni 2026, Kapitel 9.10.
		</p>
	</div>
</section>

<script>
	// Rough bracket lookup: gross salary -> taxable income (flat 80 %) -> the
	// first bracket of the Botschaft table that contains it. Shows that
	// bracket's maximum; the open top bracket only has a minimum.
	type Status = 'single' | 'couple';

	// Rough conversion from gross salary to taxable income (social-security
	// contributions, occupational and insurance deductions, standard allowances).
	const TAXABLE_RATIO = 0.8;

	const form = document.getElementById('cost-calc') as HTMLFormElement | null;
	const submitButton = document.getElementById('calc-submit') as HTMLButtonElement | null;
	const result = document.getElementById('cost-calc-result');
	const salaryLabel = document.getElementById('calc-salary-label');
	const salaryInput = document.getElementById('calc-salary') as HTMLInputElement | null;
	const monthsLegend = document.getElementById('calc-months-legend');
	const partnerGroup = document.getElementById('calc-partner-group');
	const salaryPartnerInput = document.getElementById('calc-salary-partner') as HTMLInputElement | null;
	const statusInputs = document.querySelectorAll<HTMLInputElement>('input[name="status"]');
	const outAdded = document.getElementById('calc-out-added');
	const outMonth = document.getElementById('calc-out-month');
	const outMonthWrap = document.getElementById('calc-out-month-wrap');
	const outBasis = document.getElementById('calc-out-basis');
	const outTop = document.getElementById('calc-out-top');

	if (
		form &&
		submitButton &&
		result &&
		salaryLabel &&
		salaryInput &&
		monthsLegend &&
		partnerGroup &&
		salaryPartnerInput &&
		outAdded &&
		outMonth &&
		outMonthWrap &&
		outBasis &&
		outTop
	) {
		const brackets: { single: number; couple: number }[] = JSON.parse(form.dataset.brackets ?? '[]');
		const maxes: number[] = JSON.parse(form.dataset.maxes ?? '[]');
		const fmt = (n: number) => 'CHF ' + Math.round(n).toLocaleString('de-CH');

		const getStatus = (): Status =>
			Array.from(statusInputs).find((input) => input.checked)?.value === 'couple' ? 'couple' : 'single';

		const isReady = () => {
			if (salaryInput.value.trim() === '') return false;
			return getStatus() !== 'couple' || salaryPartnerInput.value.trim() !== '';
		};

		const updateSubmitState = () => {
			const ready = isReady();
			submitButton.classList.toggle('is-disabled', !ready);
			submitButton.setAttribute('aria-disabled', String(!ready));
			submitButton.title = ready
				? ''
				: getStatus() === 'couple'
					? 'Bitte geben Sie beide Monatslöhne ein, 0 ist möglich.'
					: 'Bitte geben Sie Ihren Monatslohn ein.';
		};

		const updateForStatus = (status: Status) => {
			const isCouple = status === 'couple';
			partnerGroup.hidden = !isCouple;
			salaryLabel.textContent = isCouple ? 'Ihr Monatslohn (brutto), CHF' : 'Monatslohn (brutto), CHF';
			monthsLegend.textContent = isCouple ? 'Ihre Auszahlungen pro Jahr' : 'Auszahlungen pro Jahr';
		};

		salaryInput.addEventListener('input', updateSubmitState);
		salaryPartnerInput.addEventListener('input', updateSubmitState);

		statusInputs.forEach((input) => {
			input.addEventListener('change', () => {
				if (input.checked) updateForStatus(input.value === 'couple' ? 'couple' : 'single');
				updateSubmitState();
			});
		});

		updateSubmitState();

		form.addEventListener('submit', (event) => {
			event.preventDefault();

			if (!isReady()) {
				updateSubmitState();
				(getStatus() === 'couple' && salaryInput.value.trim() !== '' ? salaryPartnerInput : salaryInput).focus();
				return;
			}

			const data = new FormData(form);
			const salary = Number(data.get('salary'));
			const months = Number(data.get('months'));
			const status: Status = data.get('status') === 'couple' ? 'couple' : 'single';
			const partnerSalaryRaw = Number(data.get('salaryPartner'));
			const partnerSalary =
				status === 'couple' && Number.isFinite(partnerSalaryRaw) ? Math.max(0, partnerSalaryRaw) : 0;
			const partnerMonths = status === 'couple' ? Number(data.get('monthsPartner')) : 0;

			if (!Number.isFinite(salary) || salary <= 0) {
				result.hidden = true;
				salaryInput.focus();
				return;
			}

			const grossYear = salary * months + partnerSalary * partnerMonths;
			const taxable = grossYear * TAXABLE_RATIO;
			const index = maxes.findIndex((max) => taxable <= max);
			const isTop = index === -1;
			const added = brackets[isTop ? brackets.length - 1 : index][status];

			outAdded.textContent = (isTop ? 'mindestens ' : 'bis zu ') + fmt(added);
			outMonth.textContent = fmt(added / 12);
			outMonthWrap.hidden = isTop;
			outTop.hidden = !isTop;
			outBasis.textContent =
				'Geschätzt aus einem ' +
				(status === 'couple' ? 'gemeinsamen Bruttolohn' : 'Bruttolohn') +
				' von ' +
				fmt(grossYear) +
				' pro Jahr, steuerbares Einkommen pauschal rund ' +
				fmt(taxable) +
				' (Stufe ' +
				(isTop
					? "über CHF 250'000"
					: (index === 0 ? 'CHF 0' : fmt(maxes[index - 1] + 1)) + ' bis ' + fmt(maxes[index])) +
				').';
			result.hidden = false;
		});
	}

	// Highlight a donut segment while its legend entry (or the segment itself)
	// is hovered.
	const figure = document.querySelector<HTMLElement>('.cost-share');
	if (figure) {
		const targets = figure.querySelectorAll<HTMLElement | SVGElement>('[data-index]');
		const centerValue = figure.querySelector<SVGTextElement>('.cost-donut-value')!;
		const centerLabel = figure.querySelector<SVGTextElement>('.cost-donut-label')!;
		const setActive = (index: string | null) => {
			figure.classList.toggle('is-focus', index !== null);
			targets.forEach((el) => el.classList.toggle('is-active', el.dataset.index === index));
			// Show the hovered segment's share in the middle of the donut.
			const segment = figure.querySelector<SVGPathElement>(`path[data-index="${index}"]`);
			centerValue.textContent = segment?.dataset.value ?? '';
			centerLabel.textContent = segment?.dataset.label ?? '';
		};
		targets.forEach((el) => {
			el.addEventListener('mouseenter', () => setActive(el.dataset.index ?? null));
			el.addEventListener('mouseleave', () => setActive(null));
		});
	}
</script>
