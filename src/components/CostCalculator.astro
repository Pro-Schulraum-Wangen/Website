---
// Interactive cost calculator for the homepage.
//
// Figures are taken from the municipal council's official message
// ("Botschaft Neubau Schulanlage Wangen «Am Buechberg»", 11 June 2026):
// - chapter 3 / 9.1 / 9.4: gross cost, cantonal contributions, net cost
// - chapter 9.8 to 9.10: planned tax-rate rise from 135 % to 150 % and the
//   resulting additional municipal tax per year by taxable income.

import { DOCUMENTS, ESTV_CALCULATOR_URL, GITHUB_CALCULATOR_URL } from '../consts';

const GROSS_COST = 55_600_000;
const CANTON_CONTRIBUTION = 5_600_000;
const NET_COST = GROSS_COST - CANTON_CONTRIBUTION;

const fmt = (n: number) => n.toLocaleString('de-CH');
---

<section class="block alt">
	<div class="wrap narrow">
		<div class="section-head">
			<h2>Was kostet mich das Projekt?</h2>
		</div>

		<ul class="cost-summary">
			<li>
				<span class="cost-summary-label">Gesamtkosten (brutto, exkl. Teuerung)</span>
				<span class="cost-summary-value">CHF {fmt(GROSS_COST)}</span>
			</li>
			<li>
				<span class="cost-summary-label">− erwartete Beiträge des Kantons Schwyz</span>
				<span class="cost-summary-value">CHF {fmt(CANTON_CONTRIBUTION)}</span>
			</li>
			<li class="cost-summary-total">
				<span class="cost-summary-label">= Nettobelastung der Gemeinde Wangen</span>
				<span class="cost-summary-value">CHF {fmt(NET_COST)}</span>
			</li>
		</ul>

		<h3 class="cost-calc-title">Ihr persönlicher Anteil</h3>
		<p>
			Zur Finanzierung der Schulanlage und weiterer bereits geplanter Investitionen
			plant der Gemeinderat, den Steuerfuss ab 2028 von 135 % auf 150 % zu erhöhen.
			Rechnen Sie aus, was diese Erhöhung Sie ungefähr kostet.
		</p>

		<details class="cost-calc-explainer">
			<summary>Was heisst «Steuerfuss 150 %»?</summary>
			<div class="cost-calc-explainer-body">
				<p>
					Ihre Einkommenssteuer wird auf zwei Ebenen berechnet. Die{' '}
					<strong>direkte Bundessteuer</strong> geht an den Bund und hat mit dieser
					Vorlage nichts zu tun.
				</p>
				<p>
					Für die Steuern im Kanton wird zuerst die sogenannte{' '}
					<strong>einfache Steuer</strong> berechnet. Sie dient als gemeinsame Referenz.{' '}
					<strong>
						Kanton, Bezirk, Gemeinde und Kirche beziehen davon jeweils einen bestimmten
						Prozentsatz. Dieser Prozentsatz heisst Steuerfuss.
					</strong>
				</p>
				<p>
					Ein Beispiel: Wer rund CHF 55'000 im Jahr verdient, versteuert nach den
					Abzügen noch etwa CHF 40'000. Daraus errechnet der kantonale Tarif die
					einfache Steuer, in diesem Beispiel CHF 1'000. Je höher das Einkommen, desto
					höher auch diese Referenz. So sieht die Rechnung für Wangen heute aus:
				</p>
				<div class="cost-calc-table-wrap">
					<table>
						<thead>
							<tr>
								<th>Geht an</th>
								<th>Steuerfuss</th>
								<th>Steuer</th>
							</tr>
						</thead>
						<tbody>
							<tr><td>Kanton Schwyz</td><td>110 %</td><td>CHF 1'100</td></tr>
							<tr><td>Bezirk March</td><td>30 %</td><td>CHF 300</td></tr>
							<tr><td>Gemeinde Wangen</td><td>135 %</td><td>CHF 1'350</td></tr>
							<tr><td>röm.-kath. Kirche</td><td>30 %</td><td>CHF 300</td></tr>
							<tr><td>evang.-ref. Kirche</td><td>14 %</td><td>CHF 140</td></tr>
						</tbody>
					</table>
				</div>
				<p>
					Die einfache Steuer von CHF 1'000 zahlen Sie nirgends direkt, sie ist{' '}
					<strong>nur die Referenz für die Berechnung</strong>. Bei einem Steuerfuss von
					135 % erhält die Gemeinde CHF 1'350, bei 150 % wären es CHF 1'500.
				</p>
				<p>
					Mit der Schulraumvorlage steigt{' '}
					<strong>nur der Steuerfuss der Gemeinde Wangen von 135 % auf 150 %</strong>. Bei
					CHF 1'000 einfacher Steuer sind das CHF 150 mehr pro Jahr. Kanton, Bezirk und
					Kirche bleiben unverändert.
				</p>
				<p>
					Bezahlt wird die Schulanlage von der Gemeinde Wangen; der Kanton steuert
					zusätzlich rund 5,6 Mio. Franken bei.
				</p>
				<p>
					Im Kanton Schwyz liegt Wangen mit 150 % am oberen Ende; nur wenige der rund
					30 Gemeinden verlangen mehr (siehe{' '}
					<a href={DOCUMENTS.steuerfusstabelle} target="_blank" rel="noopener">
						Steuerfusstabelle des Kantons Schwyz
					</a>, Seite 2, Spalte «Gemeinde»). Schweizweit fahren wir trotzdem gut: Der
					Kanton Schwyz besteuert Einkommen und Vermögen seit Jahren so tief wie kaum
					ein anderer Kanton. Was die Erhöhung für Ihren Haushalt bedeutet, zeigt der
					Rechner unten; für den gesamtschweizerischen Vergleich dient der{' '}
					<a href={ESTV_CALCULATOR_URL} target="_blank" rel="noopener">
						Steuerrechner der Eidgenössischen Steuerverwaltung
					</a>.
				</p>
			</div>
		</details>

		<form class="cost-calc" id="cost-calc" novalidate>
			<div class="cost-calc-field">
				<label for="calc-salary">Monatslohn (brutto), CHF</label>
				<input
					type="number"
					id="calc-salary"
					name="salary"
					inputmode="numeric"
					min="0"
					step="100"
					placeholder="z. B. 6500"
					required
				/>
			</div>

			<div class="cost-calc-field">
				<span class="cost-calc-legend">Auszahlungen pro Jahr</span>
				<div class="cost-calc-choice">
					<label><input type="radio" name="months" value="12" checked /> 12 ×</label>
					<label><input type="radio" name="months" value="13" /> 13 ×</label>
				</div>
			</div>

			<div class="cost-calc-field">
				<span class="cost-calc-legend">Zivilstand</span>
				<div class="cost-calc-choice">
					<label><input type="radio" name="status" value="single" checked /> Alleinstehend</label>
					<label><input type="radio" name="status" value="couple" /> Verheiratet</label>
				</div>
				<p class="cost-calc-hint">
					Der Kanton Schwyz kennt für Alleinstehende und Verheiratete
					unterschiedliche Steuertarife. Bei gleichem Einkommen fällt die
					zusätzliche Steuer für Verheiratete deshalb etwas tiefer aus.
				</p>
			</div>

			<button type="submit" class="button primary">Berechnen</button>
		</form>

		<div class="cost-calc-result" id="cost-calc-result" aria-live="polite" hidden>
			<p class="cost-calc-headline">Geschätzte zusätzliche Gemeindesteuer pro Jahr</p>
			<p class="cost-calc-big">
				<span id="calc-out-added">…</span>
				<span class="cost-calc-big-label">
					das sind rund <span id="calc-out-month">…</span> pro Monat
				</span>
			</p>
			<p class="cost-calc-note">
				Heute, bei einem Steuerfuss von 135 %, zahlen Sie rund{' '}
				<span id="calc-out-current">…</span> Gemeindesteuer pro Jahr; bei 150 %
				wären es rund <span id="calc-out-new">…</span>. Bis 2025 lag der Steuerfuss
				bereits bei 150 %, die Erhöhung bringt ihn also dorthin zurück.
			</p>
			<p class="cost-calc-note" id="calc-out-basis"></p>

			<div class="cost-calc-context">
				<h3>Sie bekommen dafür einen Gegenwert</h3>
				<p>
					Dieser Betrag ist kein verlorenes Geld. Investitionen in die Gemeinde
					schaffen einen konkreten Gegenwert: gute Schulen, zeitgemässe Infrastruktur,
					attraktive öffentliche Räume und gute Bedingungen für Vereine und das
					Dorfleben. All das trägt dazu bei, dass Wangen auch langfristig ein
					attraktiver Wohn- und Lebensort bleibt.
				</p>
				<p>
					Von einer modernen Schul- und Sportanlage, einem neu gestalteten Dorfplatz
					und besseren Räumen für die Vereine profitiert das ganze Dorf, auch wer keine
					schulpflichtigen Kinder hat.
				</p>
				<p>
					Und «einfach nichts tun» gibt es nicht: Gewisse Investitionen sind so oder so
					nötig. Ein Nein kostet die Gemeinde laut Botschaft des Gemeinderates über
					CHF 23 Mio. für Sanierungen der alten Gebäude, für Provisorien und durch den
					Verlust der zugesicherten Kantonsbeiträge. Die bestehenden Raumprobleme wären
					damit trotzdem nicht gelöst.
				</p>
			</div>
		</div>

		<p class="cost-calc-disclaimer">
			Grobe Schätzung auf Basis des Bruttolohns; das steuerbare Einkommen nach
			Abzügen (und damit der effektive Betrag) liegt in der Regel tiefer. Kinderabzüge
			und weitere persönliche Abzüge sind nicht abgebildet; für Familien mit Kindern
			fällt der Betrag entsprechend tiefer aus. Ohne Kirchensteuer. Die
			Steuerfuss-Erhöhung auf 150 % finanziert die Schulanlage sowie weitere bereits
			geplante Investitionen. Quelle:{' '}
			<a href={DOCUMENTS.botschaft} target="_blank" rel="noopener">
				Botschaft des Gemeinderates Wangen
			</a>{' '}
			vom 11. Juni 2026, Kapitel 9. Die vollständige Berechnung lässt sich jederzeit im{' '}
			<a href={GITHUB_CALCULATOR_URL} target="_blank" rel="noopener">
				öffentlichen Quellcode auf GitHub
			</a>{' '}
			nachvollziehen.
		</p>
		<noscript>
			<p class="cost-calc-disclaimer">Für den Rechner muss JavaScript aktiviert sein.</p>
		</noscript>
	</div>
</section>

<script>
	type Status = 'single' | 'couple';

	// Additional municipal tax per year caused by the 135 % to 150 % rise (a
	// 15-point step), by taxable income, for singles and couples
	// (Botschaft, chapter 9.10).
	const BRACKETS: { max: number; single: number; couple: number }[] = [
		{ max: 60_000, single: 255, couple: 203 },
		{ max: 80_000, single: 371, couple: 301 },
		{ max: 100_000, single: 488, couple: 407 },
		{ max: 120_000, single: 605, couple: 517 },
		{ max: 150_000, single: 780, couple: 693 },
		{ max: 250_000, single: 1365, couple: 1278 },
		{ max: Infinity, single: 1365, couple: 1278 },
	];

	// The municipal tax scales linearly with the tax rate ("Steuerfuss"), so the
	// 15-point step is 1/9 of today's 135 % level and 1/10 of the 150 % level.
	const CURRENT_FACTOR = 135 / 15;
	const NEW_FACTOR = 150 / 15;

	// Rough conversion from gross salary to taxable income (social-security
	// contributions, occupational and insurance deductions, standard allowances).
	const TAXABLE_RATIO = 0.8;

	const form = document.getElementById('cost-calc') as HTMLFormElement | null;
	const result = document.getElementById('cost-calc-result');
	const salaryInput = document.getElementById('calc-salary') as HTMLInputElement | null;
	const outAdded = document.getElementById('calc-out-added');
	const outMonth = document.getElementById('calc-out-month');
	const outCurrent = document.getElementById('calc-out-current');
	const outNew = document.getElementById('calc-out-new');
	const outBasis = document.getElementById('calc-out-basis');

	if (form && result && salaryInput && outAdded && outMonth && outCurrent && outNew && outBasis) {
		const fmt = (n: number) => 'CHF ' + Math.round(n).toLocaleString('de-CH');

		form.addEventListener('submit', (event) => {
			event.preventDefault();
			const data = new FormData(form);
			const salary = Number(data.get('salary'));
			const months = Number(data.get('months'));
			const status: Status = data.get('status') === 'couple' ? 'couple' : 'single';

			if (!Number.isFinite(salary) || salary <= 0) {
				result.hidden = true;
				salaryInput.focus();
				return;
			}

			const grossYear = salary * months;
			const taxable = grossYear * TAXABLE_RATIO;
			const bracket = BRACKETS.find((b) => taxable <= b.max) ?? BRACKETS[BRACKETS.length - 1];
			const added = bracket[status];

			outAdded.textContent = fmt(added);
			outMonth.textContent = fmt(added / 12);
			outCurrent.textContent = fmt(added * CURRENT_FACTOR);
			outNew.textContent = fmt(added * NEW_FACTOR);
			outBasis.textContent =
				'Geschätzt aus einem Bruttolohn von ' +
				fmt(grossYear) +
				' pro Jahr, steuerbares Einkommen rund ' +
				fmt(taxable) +
				'.';
			result.hidden = false;
		});
	}
</script>
